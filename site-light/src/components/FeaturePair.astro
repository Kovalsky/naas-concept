---
import { ROUTES } from '../lib/site';
const arrow = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M5 12h14M13 5l7 7-7 7"/></svg>`;
const features = [
  { kicker: 'Спільнота · <span lang="en">Community</span>', t: 'Рада молодих вчених', d: 'Центральна рада та ради установ, ініціативи й заходи молодих науковців Академії.', href: ROUTES.youngSci },
  { kicker: 'Розробки · <span lang="en">IP</span>', t: 'Інтелектуальна власність', d: 'Об’єкти права інтелектуальної власності, нормативна база та віртуальна виставка розробок.', href: ROUTES.ip },
];
---
<section class="section section--white" aria-label="Рада молодих вчених та інтелектуальна власність">
  <div class="wrap">
    <div class="fp-grid">
      {features.map((f) => (
        <a class="card card-lift fp" href={f.href}>
          <span class="kicker fp-kicker" set:html={f.kicker}></span>
          <span class="serif fp-t">{f.t}</span>
          <span class="fp-d">{f.d}</span>
          <span class="link-arrow fp-link">Перейти до розділу <Fragment set:html={arrow} /></span>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .fp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .fp { display: flex; flex-direction: column; align-items: flex-start; padding: 32px 34px; }
  .fp-kicker { margin-bottom: 16px; }
  .fp-t { font-size: clamp(22px, 2.4vw, 28px); font-weight: 500; line-height: 1.18; color: var(--ink); letter-spacing: -0.01em; }
  .fp-d { margin-top: 12px; font-size: 14.5px; line-height: 1.6; color: var(--ink2); max-width: 46ch; }
  .fp-link { margin-top: 22px; pointer-events: none; }
  @media (max-width: 767px) { .fp-grid { grid-template-columns: 1fr; } }
</style>
