---
// Design-version switcher: both hero variants live on the same domain.
//   /   → V3 photo/navy hero    ·    /v1 → V1 typographic hero
// The body below the hero is identical; this control only swaps the hero treatment.
interface Props { active: 'v1' | 'v3' }
const { active } = Astro.props;
---
<div class="vswitch-bar">
  <div class="wrap vswitch-in">
    <span class="mono vswitch-label">Версія дизайну головної</span>
    <div class="vswitch" role="group" aria-label="Версія дизайну головної сторінки">
      <a href="/" class:list={['vs', { on: active === 'v3' }]} aria-current={active === 'v3' ? 'page' : undefined}>
        Фото-герой
      </a>
      <a href="/v1" class:list={['vs', { on: active === 'v1' }]} aria-current={active === 'v1' ? 'page' : undefined}>
        Типографіка
      </a>
    </div>
  </div>
</div>
<style>
  .vswitch-bar { background: var(--muted); border-bottom: 1px solid var(--line); }
  .vswitch-in { display: flex; align-items: center; gap: 16px; padding: 12px 0; flex-wrap: wrap; }
  .vswitch-label { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink3); }
  .vswitch { display: inline-flex; padding: 3px; border: 1px solid var(--line); border-radius: var(--r-pill); background: #fff; }
  .vs { display: inline-flex; align-items: center; padding: 6px 16px; border-radius: var(--r-pill); font-size: 13px; font-weight: 500; color: var(--ink2); transition: background 160ms, color 160ms; }
  .vs:hover { color: var(--navy); }
  .vs.on { background: var(--navy); color: #fff; }
  .vs.on:hover { color: #fff; }
</style>
