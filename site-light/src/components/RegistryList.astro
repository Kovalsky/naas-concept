---
import type { Registry } from '../lib/registries';
interface Props { registry: Registry; lead?: string }
const { registry, lead } = Astro.props;

const fmtColor: Record<string, string> = {
  PDF: 'var(--gold)', DOC: 'var(--navy)', DOCX: 'var(--navy)', XLS: '#1F7A4D', XLSX: '#1F7A4D',
  PNG: '#737373', JPG: '#737373', JPEG: '#737373',
};
const countWord = (n: number) => (n === 1 ? 'документ' : n >= 2 && n <= 4 ? 'документи' : 'документів');
const fmtSize = (kb: number) => (kb >= 1024 ? `${(kb / 1024).toFixed(1)} MB` : kb > 0 ? `${kb} KB` : '');
---
<div class="reg-count mono kicker--muted">{registry.count} {countWord(registry.count)}</div>
{lead && <p class="reg-lead">{lead}</p>}
<div class="rows">
  {registry.items.map((it) => (
    <a href={it.href} target="_blank" rel="noopener">
      <span class="fmt-tile" style={`background:${fmtColor[it.ext] ?? 'var(--ink2)'};`}>{it.ext}</span>
      <span class="reg-main">
        <span class="reg-title">{it.title}</span>
        {it.external && <span class="mono reg-ext">зовнішнє посилання · naas.gov.ua</span>}
      </span>
      {fmtSize(it.sizeKB) && <span class="mono reg-size">{fmtSize(it.sizeKB)}</span>}
      {it.year > 0 && <span class="mono reg-year">{it.year}</span>}
      {it.external
        ? <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--ink3)" stroke-width="1.7" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
        : <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="1.7" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>}
    </a>
  ))}
</div>
<style>
  .reg-count { margin-bottom: 14px; }
  .reg-lead { font-size: 15px; color: var(--ink2); line-height: 1.6; margin-bottom: 24px; max-width: 680px; }
  .reg-main { flex: 1; min-width: 0; }
  .reg-title { display: block; font-size: 14.5px; line-height: 1.45; color: var(--ink); }
  .reg-ext { display: inline-block; margin-top: 4px; font-size: 10px; letter-spacing: 0.04em; color: var(--ink3); }
  .reg-size { flex-shrink: 0; font-size: 11.5px; color: var(--ink3); }
  .reg-year { flex-shrink: 0; font-size: 12px; color: var(--ink3); }
</style>
