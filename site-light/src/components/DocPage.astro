---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';

interface Crumb { label: string; href?: string }
interface Props {
  pageId: string;
  title: string;
  kicker?: string;
  lead?: string;
  crumbs?: Crumb[];
  description?: string;
}
const { pageId, title, kicker, lead, crumbs = [], description } = Astro.props;
const pages = await getCollection('pages');
const entry = pages.find((p) => p.id === pageId);
const { Content } = entry ? await render(entry) : { Content: null };
---
<Base title={title} description={description ?? lead}>
  <PageHero kicker={kicker ?? title} title={title} lead={lead} crumbs={crumbs} />
  <section class="section section--white">
    <div class="wrap">
      <div class="prose">
        {Content ? <Content /> : <p>Матеріали готуються до публікації.</p>}
      </div>
    </div>
  </section>
</Base>
