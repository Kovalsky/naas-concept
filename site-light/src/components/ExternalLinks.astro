---
// Homepage «Офіційні та партнерські ресурси» block — parity with the canonical
// (gravitas) home. Same i18n strings + the Prozorro profile link by ЄДРПОУ.
import { EXTERNAL } from '../lib/site';
import { contacts } from '../lib/data';
import T from './T.astro';
const links = [
  { name: 'Публічні закупівлі', desc: `Профіль розпорядника у системі Prozorro (ЄДРПОУ ${contacts.edrpou})`, url: 'prozorro.gov.ua', href: EXTERNAL.prozorro },
];
---
<section class="section section--muted" aria-labelledby="ext-h">
  <div class="wrap">
    <div class="kicker" style="margin-bottom:8px;"><T k="home.externalKicker" /></div>
    <h2 id="ext-h" class="serif ext-h"><T k="home.externalTitle" /></h2>
    <div class="ext-list">
      {links.map((x) => (
        <a class="ext-row" href={x.href} target="_blank" rel="noopener" aria-label={`${x.name} (відкриється у новій вкладці)`}>
          <span class="ext-main"><span class="ext-name serif">{x.name}</span><span class="ext-desc">{x.desc}</span></span>
          <span class="ext-url mono">{x.url}</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .ext-h { font-size: clamp(22px, 2.4vw, 28px); font-weight: 600; color: var(--ink); margin-bottom: 22px; }
  .ext-list { display: grid; gap: 10px; }
  .ext-row { display: flex; align-items: center; gap: 16px; padding: 18px 20px; border: 1px solid var(--line); border-radius: var(--r-card, 8px); background: #fff; color: var(--ink); transition: border-color 150ms, box-shadow 150ms; }
  .ext-row:hover { border-color: var(--navy); box-shadow: 0 6px 18px rgba(30, 58, 95, 0.07); }
  .ext-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .ext-name { font-size: 16px; font-weight: 600; }
  .ext-desc { font-size: 13px; color: var(--ink2); }
  .ext-url { font-size: 12px; color: var(--ink3); white-space: nowrap; }
</style>
