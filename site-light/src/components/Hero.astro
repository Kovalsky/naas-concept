---
// Homepage hero — V3 Hybrid treatment: full-bleed agrarian photo + translucent
// navy overlay, content on top (eyebrow → Lora headline → descriptor → light CTAs).
// Light reads airy/photographic vs gravitas's compact split hero.
import { Image } from 'astro:assets';
import { HOME_HERO } from '@content/site';
import { ROUTES } from '../lib/site';
import { photo } from '../lib/images';
const arrow = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="1.9"><path d="M5 12h14M13 5l7 7-7 7"/></svg>`;
const heroImg = photo('d2'); // agrarian field — swap for a NAAS-owned hero plate later
---
<section class="hero3" aria-labelledby="hero-h">
  {heroImg
    ? <Image class="hero3-img" src={heroImg} alt="" widths={[900, 1440, 1920]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" decoding="async" />
    : <span class="hero3-img hero3-ph" aria-hidden="true"></span>}
  <span class="hero3-overlay" aria-hidden="true"></span>
  <span class="hero3-cap mono" aria-hidden="true">Аграрне поле · ілюстративне фото</span>
  <div class="wrap hero3-in">
    <div class="hero3-text">
      <div class="hero3-eyebrow">Засн. 1918 · <span lang="en">National Academy of Agrarian Sciences of Ukraine</span></div>
      <h1 id="hero-h" class="serif hero3-h1">{HOME_HERO.h1}</h1>
      <p class="hero3-lead">{HOME_HERO.descriptor}</p>
      <div class="hero3-cta">
        <a class="hero3-btn" href={ROUTES.today}>НААН сьогодні</a>
        <a class="hero3-link" href={ROUTES.structure}>Структура Академії <Fragment set:html={arrow} /></a>
      </div>
    </div>
  </div>
</section>
<style>
  .hero3 { position: relative; min-height: 580px; display: flex; align-items: center; overflow: hidden; background: var(--navy-deep); }
  .hero3-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 42%; filter: grayscale(0.22) contrast(1.05) brightness(0.96) saturate(1.06); }
  .hero3-ph { background: linear-gradient(160deg, #2c3e54, var(--navy-deep)); }
  .hero3-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(14,31,53,0.74) 0%, rgba(30,58,95,0.5) 44%, rgba(14,31,53,0.8) 100%); }
  .hero3-cap { position: absolute; top: 15px; right: 22px; z-index: 2; font-size: 10px; letter-spacing: 0.08em; color: rgba(255,255,255,0.45); }
  .hero3-in { position: relative; z-index: 2; padding: 68px 0; }
  .hero3-text { max-width: 720px; }
  .hero3-eyebrow { font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: 0.13em; text-transform: uppercase; color: rgba(255,255,255,0.72); margin-bottom: 22px; }
  .hero3-h1 { font-weight: 500; font-size: clamp(36px, 5.4vw, 64px); line-height: 1.05; letter-spacing: -0.02em; color: #fff; text-wrap: balance; }
  .hero3-lead { font-size: clamp(16px, 1.9vw, 19px); line-height: 1.5; color: rgba(255,255,255,0.86); margin-top: 22px; max-width: 560px; }
  .hero3-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 26px; margin-top: 36px; }
  .hero3-btn { display: inline-flex; align-items: center; gap: 9px; background: #fff; color: var(--navy); padding: 14px 26px; border-radius: var(--r-btn); font-size: 14px; font-weight: 600; transition: background 160ms ease; }
  .hero3-btn:hover { background: rgba(255,255,255,0.9); }
  .hero3-link { display: inline-flex; align-items: center; gap: 8px; color: #fff; font-size: 14px; font-weight: 500; border-bottom: 1px solid rgba(255,255,255,0.42); padding-bottom: 3px; transition: border-color 160ms ease; }
  .hero3-link:hover { border-color: #fff; }
  .hero3-link svg { flex-shrink: 0; }
  @media (max-width: 767px) { .hero3 { min-height: 480px; } .hero3-in { padding: 46px 0; } }
</style>
