---
// Homepage hero — split layout: verbatim name + slogan + real-route links on the left,
// optimised agrarian photograph on the right. Single design (the V1/V3 variant split is retired).
import { Image } from 'astro:assets';
import { HOME_HERO } from '@content/site';
import { ROUTES } from '../lib/site';
import { photo } from '../lib/images';
const arrow = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="1.9"><path d="M5 12h14M13 5l7 7-7 7"/></svg>`;
const heroImg = photo('d2'); // sunflower field — strongest available placeholder; swap for NAAS-owned hero later
---
<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-text">
      <div class="kicker hero-kick">Засн. 1918 · <span lang="en">National Academy of Agrarian Sciences of Ukraine</span></div>
      <h1 class="serif hero-h1">{HOME_HERO.h1}</h1>
      <p class="hero-lead">{HOME_HERO.descriptor}</p>
      <p class="hero-lead hero-mission">{HOME_HERO.mission}</p>
      <div class="hero-cta">
        <a class="btn" href={ROUTES.today}>НААН сьогодні <Fragment set:html={arrow} /></a>
        <a class="link-arrow" href={ROUTES.structure}>Структура Академії <Fragment set:html={arrow} /></a>
      </div>
    </div>
    <div class="hero-shot">
      {heroImg
        ? <Image class="hero-img" src={heroImg} alt="" widths={[480, 760, 1140]} sizes="(max-width:880px) 100vw, 46vw" format="webp" loading="eager" fetchpriority="high" decoding="async" />
        : <span class="hero-img hero-ph" aria-hidden="true"></span>}
      <span class="hero-tint" aria-hidden="true"></span>
      <span class="hero-grad" aria-hidden="true"></span>
      <span class="hero-badge mono" aria-hidden="true"><span class="hero-dot"></span>84 наукові установи · 6 відділень</span>
      <span class="hero-cap mono" aria-hidden="true">Соняшникове поле · ілюстративне фото</span>
    </div>
  </div>
</section>
<style>
  .hero { border-bottom: 1px solid var(--line); background: radial-gradient(120% 80% at 90% -10%, rgba(70, 82, 46,0.07), transparent 56%); }
  .hero-in { display: grid; grid-template-columns: 1.04fr 0.96fr; gap: 46px; padding: 56px 0; align-items: center; }
  .hero-kick { margin-bottom: 0; }
  .hero-h1 { font-weight: 600; font-size: clamp(30px, 3.8vw, 48px); line-height: 1.06; letter-spacing: -0.02em; color: var(--ink); margin-top: 16px; }
  .hero-lead { font-size: clamp(16px, 1.7vw, 18px); line-height: 1.55; color: var(--ink2); margin-top: 18px; max-width: 44ch; }
  .hero-mission { font-size: clamp(14px, 1.5vw, 15.5px); margin-top: 12px; color: var(--ink3); }
  .hero-cta { display: flex; align-items: center; gap: 24px; margin-top: 28px; flex-wrap: wrap; }

  .hero-shot { position: relative; border-radius: 18px; overflow: hidden; aspect-ratio: 4/3; border: 1px solid var(--line); }
  /* Decorative photo: desaturate + navy grade so mixed/low-quality stock reads as one intentional brand treatment. */
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.32) contrast(1.04) brightness(1.02) saturate(1.05); }
  .hero-ph { background: linear-gradient(150deg, #4A5730, var(--navy-deep)); filter: none; }
  .hero-tint { position: absolute; inset: 0; background: linear-gradient(160deg, rgba(70, 82, 46,0.26) 0%, rgba(14,31,53,0.22) 100%); mix-blend-mode: multiply; }
  .hero-grad { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(12,28,48,0.45)); }
  .hero-badge { position: absolute; right: 14px; top: 14px; display: inline-flex; align-items: center; gap: 7px; font-size: 11px; color: #fff; background: rgba(12,28,48,0.55); border: 1px solid rgba(255,255,255,0.2); border-radius: var(--r-pill); padding: 6px 12px; }
  .hero-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gold-light); }
  .hero-cap { position: absolute; left: 16px; bottom: 13px; font-size: 10px; color: rgba(255,255,255,0.85); }

  @media (max-width: 880px) { .hero-in { grid-template-columns: 1fr; gap: 26px; } .hero-shot { order: -1; } }
</style>
