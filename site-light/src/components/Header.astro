---
import { getCollection } from 'astro:content';
import { NAV, ROUTES, SEARCH_INDEX } from '../lib/site';
import { STRINGS } from '../lib/i18n';
import { HERO_SLOGAN } from '../config';
import T from './T.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const base = href.split('#')[0].replace(/\/$/, '') || '/';
  if (base === '/') return path === '/';
  return path === base || path.startsWith(base + '/');
};

const news = await getCollection('news');
const searchIndex = [
  ...SEARCH_INDEX,
  ...news.map((n) => ({ title: n.data.title, href: `${ROUTES.news}/${n.data.slug}` })),
];
const searchPh = STRINGS['ui.search.ph'];
---
<!-- UTILITY BAR: verbatim slogan + a11y + language -->
<div class="util">
  <div class="wrap util-in">
    <span class="util-slogan only-desktop">{HERO_SLOGAN}</span>
    <div class="util-tools">
      <button id="hc-toggle" class="util-btn" type="button" aria-pressed="false">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
        <span><T k="ui.a11y" /></span>
      </button>
      <span class="util-sep">·</span>
      <div class="lang" role="group" aria-label="Мова інтерфейсу / Interface language">
        <button id="lang-ua" type="button" aria-pressed="true">UA</button>
        <span class="util-sep">/</span>
        <button id="lang-en" type="button" aria-pressed="false">EN</button>
      </div>
    </div>
  </div>
</div>

<!-- MAIN HEADER -->
<header class="hd">
  <div class="wrap hd-in">
    <a href={ROUTES.home} class="brand">
      <img src="/naas-emblem.png" alt="Емблема НААН" width="56" height="56" />
      <span class="brand-x">
        <span class="brand-name serif">Національна академія<br/>аграрних наук України</span>
        <span class="brand-est mono">ЗАСН. 1918</span>
      </span>
    </a>

    <nav aria-label="Головне меню" class="nav only-desktop">
      {NAV.map((item) => (
        <a href={item.href} class:list={['nav-a', { active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined} {...(item.href === ROUTES.contacts ? { 'data-astro-reload': true } : {})}>
          <T k={item.k} />
          {isActive(item.href) && <span class="nav-mark" aria-hidden="true"></span>}
        </a>
      ))}
    </nav>

    <div class="hd-tools">
      <button id="search-open" class="icon-btn" type="button" aria-label="Пошук / Search">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="11" cy="11" r="7.5"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <button id="mnav-open" class="icon-btn bordered only-mobile" type="button" aria-label="Меню / Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- SEARCH OVERLAY -->
<div id="search" hidden>
  <div id="search-scrim" class="ov-scrim"></div>
  <div role="dialog" aria-label="Пошук" aria-modal="true" class="ov-search">
    <div class="ov-search-in">
      <div class="ov-head">
        <span class="mono ov-title"><T k="ui.search.title" /></span>
        <button id="search-close" class="mono ov-close" type="button" aria-label="Закрити / Close">ESC
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="search-row">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="1.8"><circle cx="11" cy="11" r="7.5"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="search-input" type="search" autocomplete="off" placeholder={searchPh.uk} data-ph-uk={searchPh.uk} data-ph-en={searchPh.en} aria-label="Пошук / Search" />
      </div>
      <ul id="search-results" class="ov-results"></ul>
      <div id="search-empty" class="ov-empty"><span class="mono"><T k="ui.search.empty" /></span></div>
    </div>
  </div>
</div>

<!-- MOBILE DRAWER -->
<div id="mnav" hidden>
  <div id="mnav-scrim" class="ov-scrim soft"></div>
  <nav aria-label="Мобільне меню" role="dialog" aria-modal="true" class="drawer">
    <div class="drawer-head">
      <span class="mono drawer-title"><T k="ui.menu" /></span>
      <button id="mnav-close" class="icon-btn" type="button" aria-label="Закрити / Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    {NAV.map((item) => (
      <a href={item.href} class:list={['drawer-a', { active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined} {...(item.href === ROUTES.contacts ? { 'data-astro-reload': true } : {})}>
        <T k={item.k} />
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    ))}
  </nav>
</div>

<style>
  .util { background: var(--navy-deep); color: rgba(255,255,255,0.92); }
  .util-in { display: flex; align-items: center; gap: 16px; min-height: 34px; }
  .util-slogan { font-size: 11.5px; color: rgba(255,255,255,0.66); letter-spacing: 0.01em; }
  .util-tools { display: flex; align-items: center; gap: 12px; margin-left: auto; }
  .util-btn { display: flex; align-items: center; gap: 6px; padding: 6px 4px; color: rgba(255,255,255,0.82); font-size: 12px; }
  .util-btn:hover { color: #fff; }
  .util-sep { color: rgba(255,255,255,0.3); }
  .lang { display: flex; align-items: center; gap: 8px; }
  .lang button { font-family: var(--mono); font-size: 12px; font-weight: 600; padding: 6px 4px; color: rgba(255,255,255,0.5); }
  .lang #lang-ua { color: #fff; }

  .hd { position: sticky; top: 0; z-index: 60; background: rgba(255,255,255,0.96); backdrop-filter: saturate(180%) blur(8px); border-bottom: 1px solid var(--line); }
  .hd-in { min-height: 80px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 13px; }
  .brand img { width: 56px; height: 56px; object-fit: contain; flex-shrink: 0; }
  .brand-name { display: block; font-size: 14.5px; font-weight: 600; color: var(--ink); letter-spacing: -0.01em; line-height: 1.16; }
  .brand-est { display: block; font-size: 10px; color: var(--ink3); letter-spacing: 0.12em; margin-top: 4px; }

  .nav { align-items: center; gap: 28px; }
  .nav-a { position: relative; font-size: 14px; font-weight: 500; color: var(--ink2); padding: 6px 0; }
  .nav-a:hover { color: var(--navy); }
  .nav-a.active { color: var(--navy); font-weight: 600; }
  .nav-mark { position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: var(--green); border-radius: 2px; }

  .hd-tools { display: flex; align-items: center; gap: 10px; }
  .icon-btn { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: var(--r-btn); color: var(--ink2); }
  .icon-btn:hover { background: var(--muted); color: var(--navy); }
  .icon-btn.bordered { border: 1px solid var(--line); color: var(--ink); }

  /* overlays */
  .ov-scrim { position: fixed; inset: 0; z-index: 110; background: rgba(10,20,35,0.55); animation: naasFade 150ms ease; }
  .ov-scrim.soft { z-index: 90; background: rgba(10,20,35,0.45); }
  .ov-search { position: fixed; top: 0; left: 0; right: 0; z-index: 111; background: #fff; box-shadow: 0 14px 50px rgba(0,0,0,0.2); animation: naasDrop 200ms ease; }
  .ov-search-in { max-width: 860px; margin: 0 auto; padding: 28px 24px 34px; }
  .ov-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .ov-title { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--navy); }
  .ov-close { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--ink3); }
  .search-row { display: flex; align-items: center; gap: 12px; padding-bottom: 12px; border-bottom: 2px solid var(--navy); transition: border-color 160ms; }
  .search-row:focus-within { border-bottom-color: var(--green); }
  .search-row input { flex: 1; border: none; outline: none; font-size: 22px; font-family: var(--serif); background: transparent; padding: 2px 0; color: var(--ink); }
  .search-row input:focus-visible { outline: 2px solid var(--navy); outline-offset: 4px; border-radius: 3px; }
  .ov-results { list-style: none; margin: 18px 0 0; padding: 0; max-height: 50vh; overflow-y: auto; }
  .ov-empty { margin-top: 18px; font-size: 12px; color: var(--ink3); display: none; }

  .drawer { position: fixed; top: 0; right: 0; bottom: 0; z-index: 100; width: min(340px,86vw); background: #fff; box-shadow: -12px 0 40px rgba(0,0,0,0.18); padding: 22px; animation: naasDrop 200ms ease; overflow-y: auto; }
  .drawer-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
  .drawer-title { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink3); }
  .drawer-a { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 15px 4px; border-bottom: 1px solid var(--line); font-size: 16px; font-weight: 500; color: var(--ink); }
  .drawer-a.active { color: var(--navy); font-weight: 600; }
  .drawer-a.active svg { color: var(--navy); }
  .drawer-a svg { color: var(--ink3); }
</style>

<script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)}></script>
<script is:inline define:vars={{ CONTACTS: ROUTES.contacts }}>
  (function () {
    var root = document.documentElement;
    var LK = 'naas-lang';
    var FOCUSABLE = 'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])';

    function applyLang(lang) {
      var ua = document.getElementById('lang-ua');
      var en = document.getElementById('lang-en');
      var input = document.getElementById('search-input');
      if (lang === 'en') root.setAttribute('data-lang', 'en'); else root.removeAttribute('data-lang');
      // Keep <html lang="uk">: body content is always Ukrainian; only chrome strings translate
      // (each carries its own lang="en"/"uk" via <T>). Flipping the root lang would make screen
      // readers mispronounce the Ukrainian body. (WCAG 3.1.1 / 3.1.2)
      if (ua) { ua.style.color = lang === 'en' ? 'rgba(255,255,255,0.5)' : '#fff'; ua.setAttribute('aria-pressed', String(lang !== 'en')); }
      if (en) { en.style.color = lang === 'en' ? '#fff' : 'rgba(255,255,255,0.5)'; en.setAttribute('aria-pressed', String(lang === 'en')); }
      if (input) input.setAttribute('placeholder', lang === 'en' ? input.getAttribute('data-ph-en') : input.getAttribute('data-ph-uk'));
    }
    function savedLang() { try { return localStorage.getItem(LK) || 'uk'; } catch (e) { return 'uk'; } }
    function setLang(l) { try { localStorage.setItem(LK, l); } catch (e) {} applyLang(l); }

    function showPanel(id, show) {
      var el = document.getElementById(id);
      if (!el) return;
      if (show) {
        el.__lastFocus = document.activeElement;
        el.hidden = false;
        var first = id === 'search' ? document.getElementById('search-input') : el.querySelector(FOCUSABLE);
        if (first) first.focus();
      } else if (!el.hidden) {
        el.hidden = true;
        if (el.__lastFocus && el.__lastFocus.focus) el.__lastFocus.focus();
      }
    }
    // Attach a listener once per element instance (elements are fresh after each transition).
    function bind(id, ev, fn) {
      var e = document.getElementById(id);
      if (e && !e['__b_' + ev]) { e['__b_' + ev] = 1; e.addEventListener(ev, fn); }
    }
    function trap(id) {
      var el = document.getElementById(id);
      if (!el || el.__trap) return; el.__trap = 1;
      el.addEventListener('keydown', function (e) {
        if (e.key !== 'Tab' || el.hidden) return;
        var f = Array.prototype.filter.call(el.querySelectorAll(FOCUSABLE), function (n) { return n.offsetParent !== null; });
        if (!f.length) return;
        var a = f[0], b = f[f.length - 1];
        if (e.shiftKey && document.activeElement === a) { e.preventDefault(); b.focus(); }
        else if (!e.shiftKey && document.activeElement === b) { e.preventDefault(); a.focus(); }
      });
    }
    function renderSearch(q) {
      var results = document.getElementById('search-results');
      var empty = document.getElementById('search-empty');
      var idxEl = document.getElementById('search-index');
      if (!results) return;
      var INDEX = idxEl ? JSON.parse(idxEl.textContent || '[]') : [];
      results.innerHTML = '';
      var query = (q || '').toLowerCase().trim();
      var matches = query
        ? INDEX.filter(function (it) { return (it.title || '').toLowerCase().indexOf(query) !== -1; }).slice(0, 12)
        : INDEX.slice(0, 8);
      if (empty) empty.style.display = matches.length ? 'none' : 'block';
      matches.forEach(function (it) {
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = it.href; a.textContent = it.title;
        if (it.external) { a.target = '_blank'; a.rel = 'noopener'; } // external resource → new tab
        if (it.href === CONTACTS) a.setAttribute('data-astro-reload', ''); // Turnstile page → full load
        a.style.cssText = 'display:block; padding:12px 6px; border-bottom:1px solid var(--line); font-size:15px; color:var(--ink);';
        li.appendChild(a); results.appendChild(li);
      });
    }

    function setup() {
      var hc = document.getElementById('hc-toggle');
      if (hc) {
        hc.setAttribute('aria-pressed', String(root.getAttribute('data-hc') === 'true'));
        if (!hc.__b) {
          hc.__b = 1;
          hc.addEventListener('click', function () {
            var on = root.getAttribute('data-hc') !== 'true';
            root.setAttribute('data-hc', on ? 'true' : 'false');
            hc.setAttribute('aria-pressed', String(on));
            try { localStorage.setItem('naas-hc', on ? 'true' : 'false'); } catch (e) {}
          });
        }
      }
      applyLang(savedLang());
      bind('lang-ua', 'click', function () { setLang('uk'); });
      bind('lang-en', 'click', function () { setLang('en'); });
      bind('search-open', 'click', function () { showPanel('search', true); });
      bind('search-close', 'click', function () { showPanel('search', false); });
      bind('search-scrim', 'click', function () { showPanel('search', false); });
      bind('mnav-open', 'click', function () { showPanel('mnav', true); });
      bind('mnav-close', 'click', function () { showPanel('mnav', false); });
      bind('mnav-scrim', 'click', function () { showPanel('mnav', false); });
      trap('search'); trap('mnav');
      bind('search-input', 'input', function () { renderSearch(document.getElementById('search-input').value); });
      bind('search-input', 'focus', function () { var i = document.getElementById('search-input'); if (i && !i.value) renderSearch(''); });
    }

    if (!window.__naasHdr) {
      window.__naasHdr = true;
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { showPanel('search', false); showPanel('mnav', false); } });
      document.addEventListener('astro:page-load', setup); // re-init after each view transition
    }
    setup(); // initial load
  })();
</script>
