---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { anonsy } from '../lib/data';
import { img } from '../lib/images';
import { ROUTES } from '../lib/site';

const newsItems = (await getCollection('news')).sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
const featured = newsItems[0];
const rest = newsItems.slice(1, 5);
const featImg = featured ? img(featured.data.image) : undefined;

const MON = ['СІЧ', 'ЛЮТ', 'БЕР', 'КВІ', 'ТРА', 'ЧЕР', 'ЛИП', 'СЕР', 'ВЕР', 'ЖОВ', 'ЛИС', 'ГРУ'];
const fmtNews = (d: string) => { const [y, m, day] = d.split('-'); return `${day} ${MON[(+m) - 1]} ${y}`; };

const UA_MON: Record<string, string> = { січня: 'СІЧ', лютого: 'ЛЮТ', березня: 'БЕР', квітня: 'КВІ', травня: 'ТРА', червня: 'ЧЕР', липня: 'ЛИП', серпня: 'СЕР', вересня: 'ВЕР', жовтня: 'ЖОВ', листопада: 'ЛИС', грудня: 'ГРУ' };
const parseAnons = (date: string) => {
  const m = date.match(/(\d{1,2})\s+([а-яіїєґ']+)/i);
  if (!m) return { day: date, mon: '' };
  return { day: m[1], mon: UA_MON[m[2].toLowerCase()] ?? m[2].slice(0, 3).toUpperCase() };
};
const arrow = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M5 12h14M13 5l7 7-7 7"/></svg>`;
---
<section class="section section--white" aria-label="Новини та анонси">
  <div class="wrap">
    <div class="news-wrap">
      <!-- НОВИНИ — editorial featured + list -->
      <div class="news-col">
        <div class="sect-head" style="margin-bottom:22px;">
          <div class="col">
            <div class="kicker" style="margin-bottom:8px;">Новини · <span lang="en">News</span></div>
            <h2 class="h2">Новини</h2>
          </div>
          <a class="link-arrow" href={ROUTES.news}>Усі новини <Fragment set:html={arrow} /></a>
        </div>

        {featured && (
          <a class="feat" href={`${ROUTES.news}/${featured.data.slug}`}>
            {featImg
              ? <Image class="feat-img" src={featImg} alt="" widths={[400, 760, 1140]} sizes="(max-width:900px) 100vw, 58vw" format="webp" loading="lazy" decoding="async" />
              : <img class="feat-img" src={featured.data.image} alt="" width="720" height="380" loading="lazy" />}
            <span class="mono feat-meta">{fmtNews(featured.data.date)} · {featured.data.tag}</span>
            <span class="serif feat-title">{featured.data.title}</span>
            <span class="feat-dek">{featured.data.teaser}</span>
          </a>
        )}

        <ul class="nlist">
          {rest.map((n) => {
            const m = img(n.data.image);
            return (
            <li>
              <a href={`${ROUTES.news}/${n.data.slug}`} class="nrow">
                {m
                  ? <Image class="nrow-img" src={m} alt="" width={64} height={64} densities={[1.5, 2]} format="webp" loading="lazy" decoding="async" />
                  : <img class="nrow-img" src={n.data.image} alt="" width="64" height="64" loading="lazy" />}
                <span class="nrow-x">
                  <span class="mono nrow-meta">{fmtNews(n.data.date)} · {n.data.tag}</span>
                  <span class="nrow-title">{n.data.title}</span>
                </span>
              </a>
            </li>
            );
          })}
        </ul>
      </div>

      <!-- АНОНСИ — «Найближчі події» date-block list -->
      <aside class="ev-col" aria-label="Анонси">
        <div class="sect-head" style="margin-bottom:18px;">
          <div class="col">
            <div class="kicker" style="margin-bottom:8px;">Анонси · <span lang="en">Events</span></div>
            <h2 class="h2" style="font-size:26px;">Анонси</h2>
          </div>
        </div>
        <ul class="evlist">
          {anonsy.map((a) => {
            const d = parseAnons(a.date);
            return (
              <li>
                <a href={ROUTES.anonsy} class="ev">
                  <span class="ev-date" aria-hidden="true">
                    <span class="mono ev-mon">{d.mon}</span>
                    <span class="serif ev-day">{d.day}</span>
                  </span>
                  <span class="ev-body">
                    <span class="ev-title">{a.title}</span>
                    <span class="mono ev-when">{a.date}</span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
        <a class="link-arrow" style="margin-top:18px;" href={ROUTES.anonsy}>Усі анонси <Fragment set:html={arrow} /></a>
      </aside>
    </div>

    <!-- НОВИНИ ВІДДІЛЕНЬ — marked placeholder (no per-division feed yet; CMS phase) -->
    <div class="depts">
      <div class="depts-head">
        <div>
          <div class="kicker" style="margin-bottom:6px;">Новини відділень · <span lang="en">Division news</span></div>
          <h3 class="serif depts-title">Новини відділень</h3>
        </div>
        <span class="demo-badge">Зразок · у наповненні</span>
      </div>
      <p class="depts-note">Стрічка формується автоматично з новин шести наукових відділень. Реалізацію передбачено в етапі з системою керування контентом (CMS).</p>
    </div>
  </div>
</section>
<style>
  .news-wrap { display: grid; grid-template-columns: 1.5fr 1fr; gap: 48px; align-items: start; }

  .feat { display: block; margin-bottom: 22px; }
  .feat-img { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: var(--r-card); border: 1px solid var(--line); background: var(--muted2); }
  .feat-meta { display: block; margin-top: 14px; font-size: 11px; letter-spacing: 0.06em; color: var(--ink3); }
  .feat-title { display: block; margin-top: 8px; font-size: 23px; font-weight: 500; line-height: 1.22; color: var(--ink); letter-spacing: -0.01em; }
  .feat:hover .feat-title { color: var(--navy); }
  .feat-dek { display: block; margin-top: 9px; font-size: 14px; line-height: 1.55; color: var(--ink2); }

  .nlist { list-style: none; margin: 0; padding: 0; }
  .nrow { display: flex; gap: 14px; padding: 14px 0; border-top: 1px solid var(--line); align-items: flex-start; }
  .nrow-img { flex-shrink: 0; width: 64px; height: 64px; object-fit: cover; border-radius: 6px; border: 1px solid var(--line); background: var(--muted2); }
  .nrow-x { min-width: 0; }
  .nrow-meta { display: block; font-size: 10px; letter-spacing: 0.05em; color: var(--ink3); margin-bottom: 4px; }
  .nrow-title { display: block; font-size: 14.5px; line-height: 1.36; color: var(--ink); font-weight: 500; }
  .nrow:hover .nrow-title { color: var(--navy); }

  .evlist { list-style: none; margin: 0; padding: 0; }
  .ev { display: flex; gap: 14px; padding: 14px 0; border-top: 1px solid var(--line); align-items: flex-start; }
  .evlist li:first-child .ev { border-top: none; padding-top: 0; }
  .ev-date { flex-shrink: 0; width: 56px; text-align: center; border: 1px solid var(--line); border-radius: var(--r-card); padding: 8px 0; }
  .ev-mon { display: block; font-size: 9.5px; letter-spacing: 0.08em; color: var(--navy); }
  .ev-day { display: block; font-size: 22px; font-weight: 600; line-height: 1; color: var(--ink); margin-top: 2px; }
  .ev-body { min-width: 0; }
  .ev-title { display: block; font-size: 14.5px; line-height: 1.4; color: var(--ink); font-weight: 500; }
  .ev:hover .ev-title { color: var(--navy); }
  .ev-when { display: block; margin-top: 5px; font-size: 11px; color: var(--ink3); }

  .depts { margin-top: 40px; border: 1px solid var(--line); border-radius: var(--r-card); background: var(--muted); padding: 24px 26px; }
  .depts-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .depts-title { font-size: 20px; font-weight: 500; color: var(--ink); }
  .depts-note { margin-top: 12px; font-size: 14px; line-height: 1.6; color: var(--ink3); max-width: 70ch; }

  @media (max-width: 900px) { .news-wrap { grid-template-columns: 1fr; gap: 40px; } }
</style>
