---
// «НААН сьогодні» — intro/mission band. Text is pulled verbatim from the real
// shared markdown (naan-sohodni.md) so nothing is invented and it never drifts.
import { getCollection } from 'astro:content';
import { ROUTES } from '../lib/site';
import T from './T.astro';

const pages = await getCollection('pages');
const entry = pages.find((p) => p.id === 'naan-sohodni');
const body = (entry as { body?: string } | undefined)?.body ?? '';
const blocks = body.split(/\n{2,}/).map((s) => s.trim()).filter(Boolean);
const intro = blocks.find((b) => !b.startsWith('#')) ?? '';
const misIdx = blocks.findIndex((b) => /^##\s*Місія/i.test(b));
const mission = misIdx >= 0 ? (blocks[misIdx + 1] ?? '') : '';
const arrow = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="1.9"><path d="M5 12h14M13 5l7 7-7 7"/></svg>`;
---
<section class="section section--white" aria-labelledby="about-h">
  <div class="wrap">
    <div class="sect-head">
      <div class="col">
        <div class="kicker" style="margin-bottom:10px;"><T k="home.todayKicker" /></div>
        <h2 id="about-h" class="h2 h2--lg">Державна самоврядна наукова організація</h2>
      </div>
      <a class="link-arrow only-desktop" href={ROUTES.today}>Докладніше про НААН <Fragment set:html={arrow} /></a>
    </div>

    <div class="about-grid">
      <p class="about-intro">{intro}</p>
      <aside class="about-mission">
        <span class="eyebrow">Місія</span>
        <p>{mission}</p>
      </aside>
    </div>
    <a class="link-arrow only-mobile" style="margin-top:24px;" href={ROUTES.today}>Докладніше про НААН <Fragment set:html={arrow} /></a>
  </div>
</section>
<style>
  .about-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 48px; align-items: start; }
  .about-intro { font-family: var(--serif); font-size: clamp(19px, 2.1vw, 23px); line-height: 1.5; color: var(--ink); font-weight: 400; }
  .about-mission { border-left: 2px solid var(--green); padding-left: 22px; }
  .about-mission .eyebrow { display: block; margin-bottom: 10px; }
  .about-mission p { font-size: 15px; line-height: 1.66; color: var(--ink2); }
  @media (max-width: 900px) { .about-grid { grid-template-columns: 1fr; gap: 28px; } }
</style>
