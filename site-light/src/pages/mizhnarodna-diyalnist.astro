---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { PLACEHOLDER_TEXT } from '../lib/site';
import { page } from '@content/pageContent';
const { meta, hero } = page('/mizhnarodna-diyalnist');
---
<Base title={meta.title} description={meta.description}>
  <PageHero title={hero!.title} kicker={hero!.kicker} lead={hero!.lead} crumbs={hero!.crumbs} />
  <section class="section section--white">
    <div class="wrap">
      <div style="border:1px dashed var(--line); border-radius:14px; background:#fff; padding:40px; text-align:center; color:var(--ink3); font-size:15px; line-height:1.6;">{PLACEHOLDER_TEXT}</div>
    </div>
  </section>
</Base>
