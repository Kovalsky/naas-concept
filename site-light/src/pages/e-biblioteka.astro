---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import periodicals from '@content/data/elibrary.json';
import { page } from '@content/pageContent';
const { meta, hero } = page('/e-biblioteka');
const sorted = [...periodicals].sort((a, b) => a.name.localeCompare(b.name, 'uk'));
---
<Base title={meta.title} description={meta.description}>
  <PageHero title={hero!.title} kicker={hero!.kicker} lead={hero!.lead} />
  <section class="section section--white">
    <div class="wrap">
      <div class="elib-bar">
        <div class="elib-search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ink3)" stroke-width="1.8"><circle cx="11" cy="11" r="7.5"/><path d="m21 21-4.3-4.3"/></svg>
          <input id="elib-filter" type="search" autocomplete="off" placeholder="Пошук видання за назвою…" aria-label="Пошук видання за назвою" />
        </div>
        <span class="elib-count mono" aria-live="polite" aria-atomic="true"><span id="elib-shown">{sorted.length}</span> / {sorted.length} видань</span>
      </div>

      <ul class="elib-grid" id="elib-grid">
        {sorted.map((p, i) => (
          <li class="elib-item" data-name={p.name.toLowerCase()}>
            <a href={p.src} target="_blank" rel="noopener" class={`jcover jc-${(i % 8) + 1}`} aria-label={`${p.name} — відкривається у новій вкладці`}>
              <span class="jc-top mono">Періодика</span>
              <span class="jc-title serif">{p.name}</span>
              <svg class="jc-arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
            </a>
          </li>
        ))}
      </ul>
      <p id="elib-empty" class="elib-empty mono" role="status" aria-live="polite" hidden>Видань за цим запитом не знайдено.</p>
    </div>
  </section>
</Base>
<style>
  .elib-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 22px; }
  .elib-search { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 240px; max-width: 460px; border: 1px solid var(--line); border-radius: var(--r-card, 6px); padding: 10px 14px; transition: border-color 140ms; }
  .elib-search:focus-within { border-color: var(--navy); box-shadow: 0 0 0 3px rgba(30, 58, 95, 0.15); }
  .elib-search input { flex: 1; border: none; outline: none; font-size: 16px; background: transparent; }
  .elib-count { font-size: 11.5px; letter-spacing: 0.04em; color: var(--ink3); white-space: nowrap; }
  .elib-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(168px, 100%), 1fr)); gap: 20px; }
  /* Journal covers — V3 Hybrid: coloured 3:4 spines, Lora title, hover lift. */
  .jcover { position: relative; display: flex; flex-direction: column; aspect-ratio: 3/4; padding: 15px 15px 17px; border-radius: var(--r-card); overflow: hidden; color: #fff; box-shadow: 0 4px 14px rgba(20,20,20,0.14); transition: transform 200ms ease, box-shadow 200ms ease; }
  .jcover::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 36%, rgba(0,0,0,0.44)); }
  .jcover:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(20,20,20,0.24); }
  .jcover:focus-visible { outline: 2px solid var(--gold-light); outline-offset: 2px; }
  .jc-top { position: relative; z-index: 1; font-size: 9px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.72); }
  .jc-title { position: relative; z-index: 1; margin-top: auto; font-size: 14.5px; font-weight: 500; line-height: 1.24; color: #fff; text-wrap: balance; padding-right: 16px; }
  .jc-arrow { position: absolute; z-index: 1; right: 13px; bottom: 16px; color: rgba(255,255,255,0); transition: color 180ms ease; }
  .jcover:hover .jc-arrow { color: rgba(255,255,255,0.9); }
  .jc-1 { background: linear-gradient(168deg, #24507e 0%, #14304f 100%); }
  .jc-2 { background: linear-gradient(168deg, #6e5a3c 0%, #3a2c16 100%); }
  .jc-3 { background: linear-gradient(168deg, #4a6e34 0%, #243d18 100%); }
  .jc-4 { background: linear-gradient(168deg, #7a4049 0%, #3a1820 100%); }
  .jc-5 { background: linear-gradient(168deg, #565656 0%, #262626 100%); }
  .jc-6 { background: linear-gradient(168deg, #356073 0%, #18323e 100%); }
  .jc-7 { background: linear-gradient(168deg, #8a7340 0%, #423318 100%); }
  .jc-8 { background: linear-gradient(168deg, #5f4a68 0%, #2c1c34 100%); }
  .elib-empty { margin-top: 20px; font-size: 13px; color: var(--ink3); }
</style>
<script is:inline>
  (function () {
    var input = document.getElementById('elib-filter');
    var grid = document.getElementById('elib-grid');
    var shown = document.getElementById('elib-shown');
    var empty = document.getElementById('elib-empty');
    if (!input || !grid) return;
    var items = Array.prototype.slice.call(grid.querySelectorAll('.elib-item'));
    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      var n = 0;
      items.forEach(function (li) {
        var hit = !q || li.getAttribute('data-name').indexOf(q) !== -1;
        li.style.display = hit ? '' : 'none';
        if (hit) n++;
      });
      if (shown) shown.textContent = String(n);
      if (empty) empty.hidden = n !== 0;
    });
  })();
</script>
