---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { img } from '../../lib/images';
import { ROUTES } from '../../lib/site';

const news = (await getCollection('news')).sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
const fmtDate = (d: string) => {
  const [y, m, day] = d.split('-');
  return `${day}.${m}.${y}`;
};
---
<Base title="Новини">
  <PageHero
    title="Новини"
    kicker="Новини Академії"
    lead="Останні новини та повідомлення Національної академії аграрних наук України."
  />
  <section class="section section--white">
    <div class="wrap">
      <div class="news-grid">
        {news.map((n) => {
          const m = img(n.data.image);
          const imgStyle = "display:block;width:100%;aspect-ratio:16/9;object-fit:cover;background:var(--muted);border-top-left-radius:var(--r-card);border-top-right-radius:var(--r-card);";
          return (
          <a href={`${ROUTES.news}/${n.data.slug}`} class="card card-lift news-card">
            {m
              ? <Image src={m} alt="" widths={[320, 480, 640]} sizes="(max-width:560px) 100vw, (max-width:900px) 50vw, 320px" format="webp" loading="lazy" decoding="async" style={imgStyle} />
              : <img src={n.data.image} alt="" width="400" height="220" loading="lazy" style={imgStyle} />}
            <span style="display:flex;flex-direction:column;gap:8px;padding:20px;">
              <span class="mono" style="font-size:11px;letter-spacing:0.04em;color:var(--ink3);">{fmtDate(n.data.date)} · {n.data.tag}</span>
              <span class="news-card__title" style="font-family:var(--serif);font-size:18px;font-weight:500;color:var(--ink);line-height:1.3;">{n.data.title}</span>
              <span style="font-size:13.5px;color:var(--ink2);line-height:1.55;">{n.data.teaser}</span>
            </span>
          </a>
          );
        })}
      </div>
    </div>
  </section>
</Base>
<style>
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 22px;
  }
  .news-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
  }
  .news-card:hover .news-card__title {
    color: var(--navy);
  }
</style>
