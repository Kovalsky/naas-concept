---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import RegistryList from '../../components/RegistryList.astro';
import { registries, LEADS } from '../../lib/registries';
import { ROUTES } from '../../lib/site';

export function getStaticPaths() {
  return registries
    .filter((r) => r.route.startsWith('/intelektualna-vlasnist/'))
    .map((registry) => ({
      params: { slug: registry.route.replace('/intelektualna-vlasnist/', '') },
      props: { registry },
    }));
}

const { registry } = Astro.props;
---
<Base title={registry.title}>
  <PageHero
    title={registry.title}
    kicker="Інтелектуальна власність"
    crumbs={[{ label: 'Інтелектуальна власність', href: ROUTES.ip }]}
  />

  <section class="section section--white">
    <div class="wrap">
      <RegistryList registry={registry} lead={LEADS[registry.route]} />
    </div>
  </section>
</Base>
