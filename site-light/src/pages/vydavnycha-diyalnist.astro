---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import sections from '@shared/data/sections.json';
const host = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/.*$/, '');
const items = sections.publications;
---
<Base title="Видавнича діяльність" description="Наукові видання НААН: державне видавництво «Аграрна наука» та фахові періодичні видання Академії.">
  <PageHero title="Видавнича діяльність НААН" kicker="Видавнича діяльність" lead="Наукові видання Академії: державне видавництво «Аграрна наука» та фахові періодичні видання НААН." />
  <section class="section section--white">
    <div class="wrap">
      <div class="rows">
        {items.map((it) => (
          <a href={it.url} target="_blank" rel="noopener">
            <span style="flex:1; min-width:0;">
              <span style="display:block; font-size:16px; font-weight:500; color:var(--ink);">{it.title}</span>
              <span style="display:block; margin-top:4px; font-size:13px; color:var(--ink2);">{it.note} · {host(it.url)}</span>
            </span>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--ink3)" stroke-width="1.7" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
