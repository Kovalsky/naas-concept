---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Placeholder from '../../components/Placeholder.astro';
import { ROUTES } from '../../lib/site';
import { page } from '@content/pageContent';

const note = 'Антикорупційна програма, контакти уповноваженої особи та канали повідомлень про корупцію буде опубліковано після того, як їх надасть розпорядник інформації.';
const { meta, hero } = page('/prozorist/zapobihannia-koruptsii');
---
<Base title={meta.title} description={meta.description}>
  <PageHero
    title={hero!.title}
    kicker={hero!.kicker}
    crumbs={hero!.crumbs}
    lead={hero!.lead}
  />
  <Placeholder note={note} />
</Base>
