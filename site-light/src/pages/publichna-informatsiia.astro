---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { registries } from '../lib/registries';
import { page } from '@content/pageContent';

// All registries that live under the Публічна інформація hub.
const items = registries.filter((r) => r.route.startsWith('/publichna-informatsiia/'));
const countWord = (n: number) => (n === 1 ? 'документ' : n >= 2 && n <= 4 ? 'документи' : 'документів');
const icon = '<path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/><ellipse cx="12" cy="5" rx="9" ry="3"/>';
const { meta, hero } = page('/publichna-informatsiia');
---
<Base title={meta.title} description={meta.description}>
  <PageHero
    title={hero!.title}
    kicker={hero!.kicker}
    lead={hero!.lead}
  />

  <section class="section section--white">
    <div class="wrap">
      <div class="hub-grid">
        {items.map((r) => (
          <a class="card card-lift hub-card" href={r.route}>
            <span class="hub-ic">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon} />
            </span>
            <span class="hub-card-title serif">{r.title}</span>
            <span class="hub-card-foot">
              <span class="hub-card-go">Відкрити <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span>
              <span class="hub-card-count">{r.count} {countWord(r.count)}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
