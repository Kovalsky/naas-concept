---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { anonsy } from '../lib/data';
---
<Base title="Анонси">
  <PageHero
    title="Анонси"
    kicker="Найближчі події"
    lead="Анонси наукових заходів, семінарів та подій Академії."
  />
  <section class="section section--white">
    <div class="wrap">
      <div class="anons-grid">
        {anonsy.map((a) => (
          <article class="card anons-card">
            <img
              src={a.image}
              alt=""
              width="400"
              height="220"
              loading="lazy"
              style="display:block;width:100%;aspect-ratio:16/9;object-fit:cover;background:var(--muted);border-top-left-radius:var(--r-card);border-top-right-radius:var(--r-card);"
            />
            <div style="display:flex;flex-direction:column;gap:9px;padding:20px;">
              <span class="mono" style="font-size:11px;letter-spacing:0.04em;color:var(--gold-ink);">{a.date}</span>
              <h2 style="font-family:var(--serif);font-size:18px;font-weight:500;color:var(--ink);line-height:1.3;">{a.title}</h2>
              <p style="font-size:13.5px;color:var(--ink2);line-height:1.55;">{a.teaser}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .anons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 22px;
  }
  .anons-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
</style>
