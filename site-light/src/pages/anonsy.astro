---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { anonsy } from '../lib/data';
import { img } from '../lib/images';
import { page } from '@content/pageContent';
const { meta, hero } = page('/anonsy');
---
<Base title={meta.title} description={meta.description}>
  <PageHero
    title={hero!.title}
    kicker={hero!.kicker}
    lead={hero!.lead}
  />
  <section class="section section--white">
    <div class="wrap">
      <div class="anons-grid">
        {anonsy.map((a) => {
          const m = img(a.image);
          const imgStyle = "display:block;width:100%;aspect-ratio:16/9;object-fit:cover;background:var(--muted);border-top-left-radius:var(--r-card);border-top-right-radius:var(--r-card);";
          return (
          <article class="card anons-card">
            {m
              ? <Image src={m} alt="" widths={[320, 480, 640]} sizes="(max-width:560px) 100vw, (max-width:900px) 50vw, 320px" format="webp" loading="lazy" decoding="async" style={imgStyle} />
              : <img src={a.image} alt="" width="400" height="220" loading="lazy" style={imgStyle} />}
            <div style="display:flex;flex-direction:column;gap:9px;padding:20px;">
              <span class="mono" style="font-size:11px;letter-spacing:0.04em;color:var(--gold-ink);">{a.date}</span>
              <h2 style="font-family:var(--serif);font-size:18px;font-weight:500;color:var(--ink);line-height:1.3;">{a.title}</h2>
              <p style="font-size:13.5px;color:var(--ink2);line-height:1.55;">{a.teaser}</p>
            </div>
          </article>
          );
        })}
      </div>
    </div>
  </section>
</Base>
<style>
  .anons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 22px;
  }
  .anons-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
</style>
