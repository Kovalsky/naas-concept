---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { PLACEHOLDER_TEXT } from '../lib/site';
---
<Base title="Виставкова діяльність" description="Участь НААН у виставках, форумах і презентаціях наукових досягнень.">
  <PageHero title="Виставкова діяльність НААН" kicker="Виставкова діяльність" lead="Участь Академії у виставках, форумах і презентаціях наукових досягнень." />
  <section class="section section--white">
    <div class="wrap">
      <div style="border:1px dashed var(--line); border-radius:14px; background:#fff; padding:40px; text-align:center; color:var(--ink3); font-size:15px; line-height:1.6;">{PLACEHOLDER_TEXT}</div>
    </div>
  </section>
</Base>
