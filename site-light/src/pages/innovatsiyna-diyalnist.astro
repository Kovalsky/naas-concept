---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { PLACEHOLDER_TEXT } from '../lib/site';
const catalog = 'https://drive.google.com/file/d/19noLIfpdJlW0mjxNkY21SQjxhWDYlp1A/view';
---
<Base title="Інноваційна діяльність" description="Інноваційні розробки та трансфер технологій НААН; каталог інноваційних розробок 2019–2025.">
  <PageHero title="Інноваційна діяльність НААН" kicker="Інноваційна діяльність" lead="Інноваційні розробки та трансфер технологій Національної академії аграрних наук України." />
  <section class="section section--white">
    <div class="wrap">
      <div class="rows">
        <a href={catalog} target="_blank" rel="noopener">
          <span style="flex:1; min-width:0;">
            <span style="display:block; font-size:16px; font-weight:500; color:var(--ink);">Каталог інноваційних розробок НААН (2019–2025)</span>
            <span style="display:block; margin-top:4px; font-size:13px; color:var(--ink2);">Селекційно-технологічні розробки науково-дослідних установ НААН · PDF</span>
          </span>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--ink3)" stroke-width="1.7" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
        </a>
      </div>
      <div style="border:1px dashed var(--line); border-radius:14px; background:#fff; padding:28px; margin-top:22px; text-align:center; color:var(--ink3); font-size:14.5px; line-height:1.6;">{PLACEHOLDER_TEXT}</div>
    </div>
  </section>
</Base>
