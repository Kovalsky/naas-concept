---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { PLACEHOLDER_TEXT } from '../lib/site';
import sections from '@content/data/sections.json';
import { page } from '@content/pageContent';
const catalog = sections.innovationCatalog;
const { meta, hero } = page('/innovatsiyna-diyalnist');
---
<Base title={meta.title} description={meta.description}>
  <PageHero title={hero!.title} kicker={hero!.kicker} lead={hero!.lead} crumbs={hero!.crumbs} />
  <section class="section section--white">
    <div class="wrap">
      <div class="rows">
        <a href={catalog.url} target="_blank" rel="noopener">
          <span style="flex:1; min-width:0;">
            <span style="display:block; font-size:16px; font-weight:500; color:var(--ink);">{catalog.title}</span>
            <span style="display:block; margin-top:4px; font-size:13px; color:var(--ink2);">{catalog.note}</span>
          </span>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--ink3)" stroke-width="1.7" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
        </a>
      </div>
      <div style="border:1px dashed var(--line); border-radius:14px; background:#fff; padding:28px; margin-top:22px; text-align:center; color:var(--ink3); font-size:14.5px; line-height:1.6;">{PLACEHOLDER_TEXT}</div>
    </div>
  </section>
</Base>
