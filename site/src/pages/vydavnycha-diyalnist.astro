---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { ROUTES } from '../lib/site';
import sections from '@content/data/sections.json';
import { page } from '@content/pageContent';
const host = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/.*$/, '');
const items = sections.publications;
const { meta, hero } = page('/vydavnycha-diyalnist');
---
<Base title={meta.title} description={meta.description}>
  <Hero kicker={hero!.kicker} title={hero!.title} crumbs={hero!.crumbs} lead={hero!.lead} />
  <section class="section section--white">
    <div class="wrap">
      <div class="rows">
        {items.map((it) => (
          <a href={it.url} target="_blank" rel="noopener">
            <span style="flex:1; min-width:0;">
              <span class="row-title">{it.title}</span>
              <span class="row-desc">{it.note} · {host(it.url)}</span>
            </span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="1.9" style="flex-shrink:0;" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
