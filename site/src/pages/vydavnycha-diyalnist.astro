---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { ROUTES } from '../lib/site';

const host = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/.*$/, '');

// Source of truth: stakeholder typed reference doc (§B7).
const items = [
  { title: 'Державне видавництво «Аграрна наука» НААН', url: 'https://www.agroscience-publishing.org.ua/', note: 'Спеціалізоване державне видавництво Академії' },
  { title: 'Вісник аграрної науки', url: 'https://agrovisnyk.com/index.php/agrovisnyk', note: 'Науково-теоретичний журнал' },
  { title: 'Аграрна наука – виробництву', url: 'https://www.agroscience-publishing.org.ua/agrarnanaukavyrobnytstvu/', note: 'Науково-виробниче видання' },
  { title: 'Agricultural Science and Practice', url: 'https://agrisp.com/index.php/agrisp', note: 'Англомовний науковий журнал' },
];
---
<Base title="Видавнича діяльність">
  <Hero
    kicker="Видавнича діяльність"
    title="Видавнича діяльність НААН"
    crumbs={[{ label: 'НААН сьогодні', href: ROUTES.today }]}
    lead="Наукові видання Академії: державне видавництво «Аграрна наука» та фахові періодичні видання НААН."
  />
  <section class="section section--white">
    <div class="wrap">
      <div class="rows">
        {items.map((it) => (
          <a href={it.url} target="_blank" rel="noopener">
            <span style="flex:1; min-width:0;">
              <span class="row-title">{it.title}</span>
              <span class="row-desc">{it.note} · {host(it.url)}</span>
            </span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="1.9" style="flex-shrink:0;" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
