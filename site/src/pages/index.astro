---
import Base from '../layouts/Base.astro';
import HeroC from '../components/HeroC.astro';
import HeroWide from '../components/HeroWide.astro';
import HomeSections from '../components/HomeSections.astro';
import AboutBand from '../components/AboutBand.astro';
// Both hero variants render; CSS shows one at a time based on <html data-hero>.
// Default = classic. There is no visible switcher — the 'wide' banner is opt-in
// via a hidden keyboard shortcut (Ctrl/Cmd+Shift+Alt+B; see Header.astro) and the
// choice is remembered in localStorage, so the live look stays classic for visitors.
---
<Base title="НААН" description="Національна академія аграрних наук України — державна самоврядна наукова організація, науково-методичний і координаційний центр з наукових проблем розвитку АПК.">
  <div class="hero-variant" data-hero="classic"><HeroC /></div>
  <div class="hero-variant" data-hero="wide"><HeroWide /></div>
  <AboutBand />
  <HomeSections />
</Base>
