---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import RegistryList from '../../components/RegistryList.astro';
import Placeholder from '../../components/Placeholder.astro';
import { byRoute, LEADS } from '../../lib/registries';
import { ROUTES } from '../../lib/site';
const registry = byRoute('/prozorist/tendery');
---
<Base title="Публічні закупівлі — річні плани">
  <Hero kicker="Прозорість" title="Річні плани закупівель" crumbs={[{ label: 'Прозорість', href: ROUTES.transparency }]} lead="Поточні процедури закупівель Академія проводить у системі Prozorro (ЄДРПОУ 00024360); тут — архів річних планів." />
  <section class="section section--white">
    <div class="wrap">
      {registry ? <RegistryList registry={registry} lead={LEADS[registry.route]} /> : <Placeholder />}
    </div>
  </section>
</Base>
