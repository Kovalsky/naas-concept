---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import VideoGallery from '../components/VideoGallery.astro';
import lectures from '../data/agrolectures.json';
---
<Base title="AGROLECTURES" description="AGROLECTURES — відеолекції та сюжети про українську аграрну науку від НААН.">
  <Hero
    kicker="Медіа"
    title="AGROLECTURES"
    lead="Цикл відеолекцій та сюжетів про українську аграрну науку, продовольчу безпеку та діяльність установ НААН."
  />
  <VideoGallery items={lectures} />
</Base>
