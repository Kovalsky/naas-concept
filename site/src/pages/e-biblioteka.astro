---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import periodicals from '@content/data/elibrary.json';
import { page } from '@content/pageContent';
const sorted = [...periodicals].sort((a, b) => a.name.localeCompare(b.name, 'uk'));
const { meta, hero } = page('/e-biblioteka');
---
<Base title={meta.title} description={meta.description}>
  <Hero kicker={hero!.kicker} title={hero!.title} lead={hero!.lead} />
  <section class="section section--white">
    <div class="wrap">
      <div class="elib-bar">
        <div class="elib-search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ink3)" stroke-width="1.8"><circle cx="11" cy="11" r="7.5"/><path d="m21 21-4.3-4.3"/></svg>
          <input id="elib-filter" type="search" autocomplete="off" placeholder="Пошук видання за назвою…" aria-label="Пошук видання за назвою" />
        </div>
        <span class="elib-count mono" aria-live="polite" aria-atomic="true"><span id="elib-shown">{sorted.length}</span> / {sorted.length} видань</span>
      </div>

      <ul class="elib-grid" id="elib-grid">
        {sorted.map((p) => (
          <li class="elib-item" data-name={p.name.toLowerCase()}>
            <a href={p.src} target="_blank" rel="noopener" class="elib-card" aria-label={`${p.name} — відкривається у новій вкладці`}>
              <svg class="elib-ic" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              <span class="elib-name">{p.name}</span>
              <svg class="elib-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M7 17 17 7M7 7h10v10"/></svg>
            </a>
          </li>
        ))}
      </ul>
      <p id="elib-empty" class="elib-empty mono" role="status" aria-live="polite" hidden>Видань за цим запитом не знайдено.</p>
    </div>
  </section>
</Base>
<style>
  .elib-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 22px; }
  .elib-search { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 240px; max-width: 460px; border: 1px solid var(--line); border-radius: 6px; padding: 10px 14px; transition: border-color 140ms; }
  .elib-search:focus-within { border-color: var(--navy); box-shadow: 0 0 0 3px rgba(30, 58, 95, 0.15); }
  .elib-search input { flex: 1; border: none; outline: none; font-size: 16px; background: transparent; }
  .elib-count { font-size: 11.5px; letter-spacing: 0.04em; color: var(--ink3); white-space: nowrap; }
  .elib-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: 12px; }
  .elib-card { display: flex; align-items: flex-start; gap: 13px; height: 100%; padding: 16px 18px; border: 1px solid var(--line); border-radius: 4px; background: #fff; transition: border-color 150ms, box-shadow 150ms; }
  .elib-card:hover { border-color: var(--navy); box-shadow: 0 6px 18px rgba(30, 58, 95, 0.07); }
  .elib-card:focus-visible { outline: 2px solid var(--navy); outline-offset: 2px; }
  .elib-ic { color: var(--navy); flex-shrink: 0; margin-top: 1px; }
  .elib-name { flex: 1; font-size: 14.5px; font-weight: 600; color: var(--ink); line-height: 1.35; }
  .elib-arrow { color: var(--ink3); flex-shrink: 0; margin-top: 3px; }
  .elib-card:hover .elib-arrow { color: var(--navy); }
  .elib-empty { margin-top: 20px; font-size: 13px; color: var(--ink3); }
</style>
<script is:inline>
  (function () {
    var input = document.getElementById('elib-filter');
    var grid = document.getElementById('elib-grid');
    var shown = document.getElementById('elib-shown');
    var empty = document.getElementById('elib-empty');
    if (!input || !grid) return;
    var items = Array.prototype.slice.call(grid.querySelectorAll('.elib-item'));
    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      var n = 0;
      items.forEach(function (li) {
        var hit = !q || li.getAttribute('data-name').indexOf(q) !== -1;
        li.style.display = hit ? '' : 'none';
        if (hit) n++;
      });
      if (shown) shown.textContent = String(n);
      if (empty) empty.hidden = n !== 0;
    });
  })();
</script>
