---
// Original homepage hero: left-aligned text with the full-width facts band below.
import T from './T.astro';
import { ROUTES } from '../lib/site';
import { divisionCount } from '../lib/data';
const arrow = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M5 12h14M13 5l7 7-7 7"/></svg>`;
const facts = [
  { n: '1918', k: 'home.factFounded' },
  { n: String(divisionCount), k: 'home.factDivisions' },
  { n: '84', k: 'home.factInstitutions' },
  { n: '176', k: 'home.factOrganizations' },
];
---
<section style="background:#fff; padding:64px 0 56px; position:relative; overflow:hidden;">
  <svg aria-hidden="true" viewBox="0 0 1440 360" preserveAspectRatio="xMidYMax slice" style="position:absolute; left:0; right:0; bottom:0; width:100%; height:300px; opacity:0.06; pointer-events:none;"><g fill="none" stroke="#1E3A5F" stroke-width="2"><path d="M0 340 Q720 280 1440 330"/><path d="M0 310 Q720 248 1440 300"/><path d="M0 280 Q720 216 1440 270"/><path d="M0 250 Q720 184 1440 240"/><path d="M0 220 Q720 152 1440 210"/><path d="M0 190 Q720 120 1440 180"/></g><path d="M0 325 Q720 264 1440 315" fill="none" stroke="#B8860B" stroke-width="2"/></svg>
  <div class="wrap" style="position:relative;">
    <div style="max-width:880px; padding:6px 0 0;">
      <div class="kicker kicker--muted" style="margin-bottom:18px;"><T k="home.todayKicker" /></div>
      <h1 style="font-family:var(--serif); font-weight:600; font-size:clamp(30px,4vw,46px); line-height:1.12; letter-spacing:-0.018em; color:var(--ink); text-wrap:balance;">Національна академія аграрних наук України</h1>
      <p style="font-family:var(--serif); font-weight:500; font-size:clamp(17px,2vw,21px); line-height:1.42; color:var(--navy); margin-top:16px; max-width:760px;">Державна самоврядна наукова організація — науково-методичний і координаційний центр з наукових проблем розвитку АПК України.</p>
      <div style="display:flex; align-items:center; gap:13px; margin-top:22px;"><span style="width:36px; height:2px; background:var(--gold);"></span><span style="font-family:var(--serif); font-style:italic; font-size:15px; color:var(--ink2);">Заснована 1918 року</span></div>
      <p style="font-size:17px; line-height:1.65; color:var(--ink2); margin-top:22px; max-width:620px;">Академія координує фундаментальні та прикладні дослідження в аграрній сфері та впроваджує наукові розробки у виробництво.</p>
      <div style="display:flex; flex-wrap:wrap; gap:26px; margin-top:26px;">
        <a class="link-underline" href={ROUTES.statute}><T k="home.statuteLink" /> <Fragment set:html={arrow} /></a>
        <a class="link-underline" href={ROUTES.presidium}><T k="home.presidiumLink" /> <Fragment set:html={arrow} /></a>
        <a class="link-underline" href={ROUTES.today}><T k="btn.more" /> <Fragment set:html={arrow} /></a>
      </div>

      <!-- full-width credibility band -->
      <div class="fact-cluster">
        {facts.map((f, i) => (
          <>
            {i > 0 && <span class="fact-div" aria-hidden="true"></span>}
            <div class="fact-col">
              <div class="fact-num">{f.n}</div>
              <div class="fact-lbl mono"><T k={f.k} /></div>
            </div>
          </>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .fact-cluster { display: flex; align-items: center; margin-top: 42px; width: 100%; }
  .fact-col { flex: 1 1 0; min-width: 0; }
  .fact-num { font-family: var(--serif); font-size: clamp(34px, 3.4vw, 42px); font-weight: 600; color: var(--navy); line-height: 1; }
  .fact-lbl { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink3); margin-top: 10px; }
  .fact-div { flex: 0 0 1px; width: 1px; height: 42px; background: var(--line); margin: 0 24px; }
  @media (max-width: 560px) {
    .fact-cluster { flex-direction: column; align-items: flex-start; gap: 22px; }
    .fact-col { flex: none; }
    .fact-div { display: none; }
  }
</style>
