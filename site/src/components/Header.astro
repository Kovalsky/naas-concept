---
import { getCollection } from 'astro:content';
import { NAV, ROUTES, SEARCH_INDEX } from '../lib/site';
import { BRAND } from '@content/site';
import { STRINGS } from '../lib/i18n';
import T from './T.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const base = href.split('#')[0].replace(/\/$/, '') || '/';
  if (base === '/') return path === '/';
  return path === base || path.startsWith(base + '/');
};

const news = await getCollection('news');
const searchIndex = [
  ...SEARCH_INDEX,
  ...news.map((n) => ({ title: n.data.title, href: `${ROUTES.news}/${n.data.slug}` })),
];
const searchPh = STRINGS['ui.search.ph'];
---
<!-- UTILITY BAR -->
<div style="background:var(--navy-deep); color:rgba(255,255,255,0.92); height:34px; font-size:12.5px;">
  <div class="wrap" style="height:100%; display:flex; align-items:center; justify-content:space-between;">
    {/* Left side intentionally empty (flex spacer keeps the controls right-aligned).
        The homepage hero-variant switch is now a hidden keyboard shortcut — see the
        Ctrl/Cmd+Shift+Alt+B handler below — so it isn't exposed to ordinary visitors. */}
    <div></div>
    <div style="display:flex; align-items:center; gap:16px;">
      <button id="hc-toggle" aria-pressed="false" aria-label="Контрастна версія для людей з вадами зору" style="display:flex; align-items:center; gap:6px; padding:6px 4px; color:rgba(255,255,255,0.85);">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
        <span class="util-label" style="font-size:12px;"><T k="ui.a11y" /></span>
      </button>
      <span style="color:rgba(255,255,255,0.3);">·</span>
      <div style="display:flex; align-items:center; gap:8px;" role="group" aria-label="Мова інтерфейсу / Interface language">
        <button id="lang-ua" aria-pressed="true" style="font-family:var(--mono); font-size:12px; font-weight:600; padding:6px 4px; color:#fff;">UA</button>
        <span style="color:rgba(255,255,255,0.3);">/</span>
        <button id="lang-en" aria-pressed="false" style="font-family:var(--mono); font-size:12px; font-weight:600; padding:6px 4px; color:rgba(255,255,255,0.5);">EN</button>
      </div>
    </div>
  </div>
</div>

<!-- MAIN HEADER -->
<header style="position:sticky; top:0; z-index:60; background:rgba(255,255,255,0.96); -webkit-backdrop-filter:saturate(180%) blur(8px); backdrop-filter:saturate(180%) blur(8px); border-bottom:1px solid var(--line);">
  <div class="wrap" style="height:84px; display:flex; align-items:center; justify-content:space-between; gap:24px;">
    <a href={ROUTES.home} style="display:flex; align-items:center; gap:13px;" aria-label="НААН — головна">
      <img class="hdr-emblem" src="/naas-emblem.png" alt="Емблема НААН" width="64" height="64" style="flex-shrink:0; width:64px; height:64px; object-fit:contain; display:block;" />
      <span style="line-height:1.16;">
        <span class="hdr-brand-name" style="display:block; font-family:var(--serif); font-size:15px; font-weight:600; color:var(--ink); letter-spacing:-0.01em;">{BRAND.nameLines[0]}<br/>{BRAND.nameLines[1]}</span>
        <span class="hdr-founded" style="display:block; font-family:var(--mono); font-size:10px; color:var(--ink3); letter-spacing:0.12em; margin-top:4px;">ЗАСН. 1918</span>
      </span>
    </a>

    <nav aria-label="Головне меню" class="hdr-nav" style="align-items:center; gap:26px;">
      {NAV.map((item) => (
        <a href={item.href} style={`position:relative; white-space:nowrap; font-size:14px; font-weight:${isActive(item.href) ? 600 : 500}; color:${isActive(item.href) ? 'var(--navy)' : 'var(--ink2)'}; padding:6px 0;`}>
          <T k={item.k} />
          {isActive(item.href) && <span style="position:absolute; left:0; right:0; bottom:-2px; height:2px; background:var(--gold); border-radius:2px;"></span>}
        </a>
      ))}
    </nav>

    <div style="display:flex; align-items:center; gap:10px;">
      <button id="search-open" aria-label="Пошук / Search" style="display:flex; align-items:center; justify-content:center; width:44px; height:44px; border-radius:6px; color:var(--ink2);">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="11" cy="11" r="7.5"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
      <button id="mnav-open" class="hdr-burger" aria-label="Меню / Menu" style="align-items:center; justify-content:center; width:44px; height:44px; border-radius:6px; color:var(--ink); border:1px solid var(--line);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- SEARCH OVERLAY -->
<div id="search" hidden>
  <div id="search-scrim" style="position:fixed; inset:0; z-index:110; background:rgba(10,20,35,0.55); animation:naasFade 150ms ease;"></div>
  <div role="dialog" aria-modal="true" aria-label="Пошук" style="position:fixed; top:0; left:0; right:0; z-index:111; background:#fff; box-shadow:0 14px 50px rgba(0,0,0,0.2); animation:naasDrop 200ms ease;">
    <div style="max-width:860px; margin:0 auto; padding:28px 24px 34px;">
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;">
        <span class="mono" style="font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:var(--navy);"><T k="ui.search.title" /></span>
        <button id="search-close" aria-label="Закрити / Close" class="mono" style="display:flex; align-items:center; gap:6px; font-size:11px; color:var(--ink3); padding:10px 8px; margin:-10px -8px;">ESC
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="search-row" style="display:flex; align-items:center; gap:12px; padding-bottom:12px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="1.8"><circle cx="11" cy="11" r="7.5"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="search-input" type="search" autocomplete="off" placeholder={searchPh.uk} data-ph-uk={searchPh.uk} data-ph-en={searchPh.en} aria-label="Пошук / Search" style="flex:1; border:none; outline:none; font-size:22px; font-family:var(--serif); background:transparent; padding:2px 0;" />
      </div>
      <ul id="search-results" style="list-style:none; margin:18px 0 0; padding:0; max-height:50vh; overflow-y:auto;"></ul>
      <div id="search-empty" style="margin-top:18px; font-size:12px; color:var(--ink3); display:none;"><span class="mono"><T k="ui.search.empty" /></span></div>
    </div>
  </div>
</div>

<!-- MOBILE DRAWER -->
<div id="mnav" hidden>
  <div id="mnav-scrim" style="position:fixed; inset:0; z-index:90; background:rgba(10,20,35,0.45); animation:naasFade 160ms ease;"></div>
  <nav role="dialog" aria-modal="true" aria-label="Мобільне меню" style="position:fixed; top:0; right:0; bottom:0; z-index:100; width:min(340px,86vw); background:#fff; box-shadow:-12px 0 40px rgba(0,0,0,0.18); padding:22px; animation:naasDrop 200ms ease; overflow-y:auto;">
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:22px;">
      <span class="mono" style="font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:var(--ink3);"><T k="ui.menu" /></span>
      <button id="mnav-close" aria-label="Закрити / Close" style="width:44px; height:44px; display:flex; align-items:center; justify-content:center; border-radius:6px; color:var(--ink2);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    {NAV.map((item) => (
      <a href={item.href} style="display:flex; align-items:center; justify-content:space-between; width:100%; padding:15px 4px; border-bottom:1px solid var(--line); font-size:16px; font-weight:500; color:var(--ink);">
        <T k={item.k} />
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="color:var(--ink3);"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    ))}
  </nav>
</div>

<style>
  /* Focus indicator that matches the design language: the field's underline
     shifts from navy to gold (same accent as active nav links) when focused. */
  .search-row { border-bottom: 2px solid var(--navy); transition: border-color 160ms; }
  .search-row:focus-within { border-bottom-color: var(--gold); }

  /* ---- header: desktop nav vs. drawer ----
     The 6-item Ukrainian nav plus the two-line wordmark stop fitting on one row
     below ~1180px (labels like «Атестація та підготовка кадрів» wrap to two lines
     and the wordmark breaks to four). Collapse to the drawer there rather than
     letting the bar break. These classes are header-only (replaced the generic
     .only-desktop/.only-mobile, whose 900px breakpoint left a broken 900–1180 band). */
  .hdr-nav { display: flex; }
  .hdr-burger { display: none; }
  @media (max-width: 1180px) {
    .hdr-nav { display: none; }
    .hdr-burger { display: flex; }
  }

  /* Hover/focus affordances. Nav-link colour is set inline per item (active vs.
     rest), so the hover override needs !important to win over the inline style. */
  .hdr-nav a { transition: color 140ms; }
  .hdr-nav a:hover { color: var(--navy) !important; }
  #search-open { transition: background 140ms, color 140ms; }
  #search-open:hover, #mnav-open:hover { background: var(--muted); }
  #search-open:hover { color: var(--navy); }
  /* Utility-bar accessibility toggle: brighten to full white on hover (inline
     colour is 85% white, so the hover needs !important to take effect). */
  #hc-toggle { transition: color 140ms; }
  #hc-toggle:hover { color: #fff !important; }

  /* Phones: compact the wordmark so the full academy name sits on two tidy lines
     beside the emblem and the two action buttons, instead of wrapping to four
     cramped lines. (font-size/width need !important to beat the inline styles.) */
  @media (max-width: 480px) {
    .hdr-emblem { width: 52px !important; height: 52px !important; }
    .hdr-brand-name { font-size: 13px !important; line-height: 1.2; }
  }
</style>

<script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)}></script>
<script is:inline>
  (function () {
    var root = document.documentElement;
    var FOCUSABLE = 'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])';
    var LK = 'naas-lang', HK = 'naas-hero', HERO_SET = ['classic', 'wide'];

    // Bind a listener once per element instance — the header DOM is fresh after each
    // view transition, so re-running setup() re-binds without duplicating handlers.
    function bind(el, ev, fn) {
      if (el && !el['__b_' + ev]) { el['__b_' + ev] = 1; el.addEventListener(ev, fn); }
    }

    // Language toggle (chrome only). Persisted in localStorage.
    function applyLang(lang) {
      var ua = document.getElementById('lang-ua');
      var en = document.getElementById('lang-en');
      var input = document.getElementById('search-input');
      if (lang === 'en') root.setAttribute('data-lang', 'en'); else root.removeAttribute('data-lang');
      root.lang = lang === 'en' ? 'en' : 'uk';
      if (ua) { ua.style.color = lang === 'en' ? 'rgba(255,255,255,0.5)' : '#fff'; ua.setAttribute('aria-pressed', String(lang !== 'en')); }
      if (en) { en.style.color = lang === 'en' ? '#fff' : 'rgba(255,255,255,0.5)'; en.setAttribute('aria-pressed', String(lang === 'en')); }
      if (input) input.setAttribute('placeholder', lang === 'en' ? input.getAttribute('data-ph-en') : input.getAttribute('data-ph-uk'));
    }
    function savedLang() { try { return localStorage.getItem(LK) || 'uk'; } catch (e) { return 'uk'; } }
    function setLang(l) { try { localStorage.setItem(LK, l); } catch (e) {} applyLang(l); }

    // Homepage hero variant (classic by default; 'wide' banner is opt-in). The pick
    // is persisted and applied via the [data-hero] CSS switch. There is no visible
    // control — it is toggled only through the hidden keyboard shortcut (see setup()).
    function curHero() { try { var v = localStorage.getItem(HK); return HERO_SET.indexOf(v) >= 0 ? v : 'classic'; } catch (e) { return 'classic'; } }
    function applyHero(h) {
      if (HERO_SET.indexOf(h) < 0) h = 'classic';
      root.setAttribute('data-hero', h);
    }
    function toggleHero() {
      var next = curHero() === 'wide' ? 'classic' : 'wide';
      try { localStorage.setItem(HK, next); } catch (e) {}
      applyHero(next);
    }

    // Panels (mobile nav + search): open/close, focus trap, and focus return.
    var lastFocus = {};
    function anyPanelOpen() {
      var s = document.getElementById('search'), m = document.getElementById('mnav');
      return (s && !s.hidden) || (m && !m.hidden);
    }
    function setPanel(id, open) {
      var el = document.getElementById(id);
      if (!el) return;
      if (open) {
        lastFocus[id] = document.activeElement;
        el.hidden = false;
        var first = id === 'search' ? document.getElementById('search-input') : el.querySelector(FOCUSABLE);
        if (first) first.focus();
      } else if (!el.hidden) {
        el.hidden = true;
        if (lastFocus[id] && lastFocus[id].focus) lastFocus[id].focus();
      }
      // Lock background scroll while any fixed panel is open (mobile especially).
      document.documentElement.style.overflow = anyPanelOpen() ? 'hidden' : '';
    }
    function trap(id) {
      var el = document.getElementById(id);
      if (!el || el.__trap) return; el.__trap = 1;
      el.addEventListener('keydown', function (e) {
        if (e.key !== 'Tab' || el.hidden) return;
        var f = Array.prototype.filter.call(el.querySelectorAll(FOCUSABLE), function (n) { return n.offsetParent !== null; });
        if (!f.length) return;
        var a = f[0], b = f[f.length - 1];
        if (e.shiftKey && document.activeElement === a) { e.preventDefault(); b.focus(); }
        else if (!e.shiftKey && document.activeElement === b) { e.preventDefault(); a.focus(); }
      });
    }

    // Search filter — re-reads the per-page #search-index each call.
    function render(q) {
      var results = document.getElementById('search-results');
      var empty = document.getElementById('search-empty');
      var idxEl = document.getElementById('search-index');
      if (!results) return;
      var INDEX = idxEl ? JSON.parse(idxEl.textContent || '[]') : [];
      results.innerHTML = '';
      var query = (q || '').toLowerCase().trim();
      var matches = query
        ? INDEX.filter(function (it) { return (it.title || '').toLowerCase().indexOf(query) !== -1; }).slice(0, 12)
        : INDEX.slice(0, 8);
      if (empty) empty.style.display = matches.length ? 'none' : 'block';
      matches.forEach(function (it) {
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = it.href; a.textContent = it.title;
        a.style.cssText = 'display:block; padding:12px 6px; border-bottom:1px solid var(--line); font-size:15px; color:var(--ink);';
        li.appendChild(a); results.appendChild(li);
      });
    }

    // (Re-)initialise on initial load and after every view transition.
    function setup() {
      bind(document.getElementById('hc-toggle'), 'click', function () {
        var on = root.getAttribute('data-hc') !== 'true';
        root.setAttribute('data-hc', on ? 'true' : 'false');
        this.setAttribute('aria-pressed', String(on));
      });

      applyHero(curHero());

      applyLang(savedLang());
      bind(document.getElementById('lang-ua'), 'click', function () { setLang('uk'); });
      bind(document.getElementById('lang-en'), 'click', function () { setLang('en'); });

      bind(document.getElementById('search-open'), 'click', function () { setPanel('search', true); });
      bind(document.getElementById('search-close'), 'click', function () { setPanel('search', false); });
      bind(document.getElementById('search-scrim'), 'click', function () { setPanel('search', false); });
      bind(document.getElementById('mnav-open'), 'click', function () { setPanel('mnav', true); });
      bind(document.getElementById('mnav-close'), 'click', function () { setPanel('mnav', false); });
      bind(document.getElementById('mnav-scrim'), 'click', function () { setPanel('mnav', false); });
      trap('search'); trap('mnav');

      var input = document.getElementById('search-input');
      bind(input, 'input', function () { render(input.value); });
      bind(input, 'focus', function () { if (input && !input.value) render(''); });
    }

    if (!window.__naasHdr) {
      window.__naasHdr = true;
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { setPanel('search', false); setPanel('mnav', false); return; }
        // Hidden homepage hero-variant toggle (no visible control): Ctrl/Cmd+Shift+Alt+B.
        // Deliberately an obscure chord so ordinary visitors never trigger it; effective
        // on the homepage, harmless elsewhere. e.code keeps it layout-independent.
        if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.altKey && e.code === 'KeyB') {
          e.preventDefault();
          toggleHero();
        }
      });
      document.addEventListener('astro:page-load', setup); // re-init after each view transition
    }
    setup(); // initial load
  })();
</script>
