---
// Hero C — classic, default homepage masthead. Typographic / wordmark-led: the
// header already carries the emblem, so the hero leads with the name (the wordmark
// IS the logo in type) instead of repeating the seal — the pattern peer academies
// use (Royal Society, NAS Ukraine, Harvard, National Academies). One positioning
// line only (the mission paragraph was dropped — it duplicated the About-band
// «Місія» panel), and the figures sit in a full-width navy band that anchors the
// hero with brand colour.
import T from './T.astro';
import { ROUTES } from '../lib/site';
import { divisionCount } from '../lib/data';
const arrow = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M5 12h14M13 5l7 7-7 7"/></svg>`;
const facts = [
  { n: '1918', k: 'home.factFounded' },
  { n: String(divisionCount), k: 'home.factDivisions' },
  { n: '84', k: 'home.factInstitutions' },
  { n: '176', k: 'home.factOrganizations' },
];
---
<section class="hc">
  <svg aria-hidden="true" class="hc-field" viewBox="0 0 1440 320" preserveAspectRatio="xMidYMax slice">
    <g fill="none" stroke="#1E3A5F" stroke-width="2">
      <path d="M0 300 Q720 244 1440 292"/><path d="M0 272 Q720 214 1440 264"/>
      <path d="M0 244 Q720 184 1440 236"/><path d="M0 216 Q720 154 1440 208"/>
    </g>
    <path d="M0 286 Q720 230 1440 278" fill="none" stroke="#B8860B" stroke-width="2"/>
  </svg>
  <div class="wrap hc-in">
    <h1 class="hc-h1">Національна академія<br/>аграрних наук України</h1>
    <span class="hc-rule" aria-hidden="true"></span>
    <p class="hc-sub">Державна самоврядна наукова організація — науково-методичний і координаційний центр з наукових проблем розвитку АПК України.</p>
    <div class="hc-links">
      <a class="link-underline" href={ROUTES.statute}><T k="home.statuteLink" /> <Fragment set:html={arrow} /></a>
      <a class="link-underline" href={ROUTES.presidium}><T k="home.presidiumLink" /> <Fragment set:html={arrow} /></a>
      <a class="link-underline" href={ROUTES.today}><T k="btn.more" /> <Fragment set:html={arrow} /></a>
    </div>
  </div>
</section>
<section class="hc-figs">
  <div class="wrap hc-figs-in">
    {facts.map((f, i) => (
      <>
        {i > 0 && <span class="hc-div" aria-hidden="true"></span>}
        <div class="hc-fact"><div class="hc-num">{f.n}</div><div class="hc-lbl mono"><T k={f.k} /></div></div>
      </>
    ))}
  </div>
</section>
<style>
  .hc { background: #fff; position: relative; overflow: hidden; padding: 60px 0 52px; }
  .hc-field { position: absolute; left: 0; right: 0; top: 0; width: 100%; height: 320px; opacity: 0.07; pointer-events: none; }
  .hc-in { position: relative; max-width: 800px; margin: 0 auto; text-align: center; }
  .hc-h1 { font-family: var(--serif); font-weight: 600; font-size: clamp(32px,4.2vw,50px); line-height: 1.1; letter-spacing: -0.02em; color: var(--ink); text-wrap: balance; }
  .hc-rule { display: block; width: 54px; height: 3px; background: var(--gold); border-radius: 2px; margin: 24px auto; }
  .hc-sub { font-family: var(--serif); font-weight: 500; font-size: clamp(17px,1.9vw,21px); line-height: 1.5; color: var(--navy); max-width: 660px; margin: 0 auto; text-wrap: pretty; }
  .hc-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 28px; margin-top: 30px; }

  /* full-width navy figures band — brand-colour anchor for the hero */
  .hc-figs { background: var(--navy); }
  .hc-figs-in { display: flex; align-items: center; justify-content: center; padding: 34px 24px; }
  .hc-fact { flex: 1 1 0; min-width: 0; text-align: center; }
  .hc-num { font-family: var(--serif); font-size: clamp(36px,3.6vw,46px); font-weight: 600; color: #fff; line-height: 1; }
  .hc-lbl { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.66); margin-top: 11px; }
  .hc-div { flex: 0 0 1px; width: 1px; height: 48px; background: rgba(255,255,255,0.16); margin: 0 22px; }
  @media (max-width: 620px) {
    .hc-figs-in { flex-wrap: wrap; gap: 26px 0; padding: 28px 20px; }
    .hc-fact { flex: 1 1 50%; }
    .hc-div { display: none; }
  }
</style>
