---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import { ROUTES } from '../../lib/site';
import { formatDateUk } from '../../lib/format';
import { page } from '@content/pageContent';

const news = (await getCollection('news')).sort((a, b) => (a.data.date < b.data.date ? 1 : -1));
const { meta, hero } = page('/novyny');
---
<Base title={meta.title} description={meta.description}>
  <Hero kicker={hero!.kicker} title={hero!.title} lead={hero!.lead} />
  <section class="section section--white">
    <div class="wrap">
      <div class="grid grid--auto">
        {news.map((n) => (
          <a href={`${ROUTES.news}/${n.data.slug}`} style="display:flex; flex-direction:column; border:1px solid var(--line); border-radius:12px; overflow:hidden; background:var(--surface); transition:border-color 160ms, box-shadow 160ms;" class="news-card">
            <img src={n.data.image} alt={n.data.title} width="400" height="200" loading="lazy" style="display:block; width:100%; height:200px; object-fit:cover; background:var(--muted);" />
            <span style="display:flex; flex-direction:column; gap:8px; padding:20px;">
              <span class="mono" style="font-size:11px; letter-spacing:0.04em; color:var(--ink3);">{formatDateUk(n.data.date)} · {n.data.tag}</span>
              <span style="font-family:var(--serif); font-size:18px; font-weight:600; color:var(--ink); line-height:1.3;">{n.data.title}</span>
              <span style="font-size:13.5px; color:var(--ink2); line-height:1.5;">{n.data.teaser}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
