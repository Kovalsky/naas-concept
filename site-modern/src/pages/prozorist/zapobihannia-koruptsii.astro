---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import { page } from '@content/pageContent';
const { meta, hero } = page('/prozorist/zapobihannia-koruptsii');

// Skeleton per ТЗ (audit item 8): anti-corruption programme, compliance
// officer, whistleblower channels, reports. Content expected from the client.
const pending = [
  'Антикорупційна програма НААН',
  'Уповноважена особа з питань запобігання та виявлення корупції',
  'Канали повідомлення про корупцію (для викривачів)',
  'Звіти та результати антикорупційних заходів',
];
---
<Base title={meta.title} description={meta.description}>
  <Hero kicker={hero!.kicker} title={hero!.title} crumbs={hero!.crumbs} lead={hero!.lead} />
  <section class="section section--white">
    <div class="wrap">
      <div class="kicker kicker--muted" style="margin-bottom:16px;">Напрями розділу</div>
      <div class="rows">
        {pending.map((label) => (
          <div class="row">
            <span style="flex:1; min-width:0;"><span class="row-title" style="color:var(--ink2);">{label}</span></span>
            <span class="mono" style="font-size:11px; color:var(--ink3); white-space:nowrap;">матеріал готується</span>
          </div>
        ))}
      </div>
      <p style="margin-top:18px; font-size:13px; color:var(--ink3); max-width:70ch;">Документи та контактні дані антикорупційного напряму оприлюднюються в міру підготовки.</p>
    </div>
  </section>
</Base>
