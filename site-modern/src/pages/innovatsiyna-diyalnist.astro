---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { ROUTES, PLACEHOLDER_TEXT } from '../lib/site';
import sections from '@content/data/sections.json';
import { page } from '@content/pageContent';
const catalog = sections.innovationCatalog;
const { meta, hero } = page('/innovatsiyna-diyalnist');
---
<Base title={meta.title} description={meta.description}>
  <Hero kicker={hero!.kicker} title={hero!.title} crumbs={hero!.crumbs} lead={hero!.lead} />
  <section class="section section--white">
    <div class="wrap">
      <div class="rows">
        <a href={catalog.url} target="_blank" rel="noopener">
          <span style="flex:1; min-width:0;">
            <span class="row-title">{catalog.title}</span>
            <span class="row-desc">{catalog.note}</span>
          </span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="1.9" style="flex-shrink:0;" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
        </a>
      </div>
      <div style="border:1px dashed var(--line); border-radius:12px; background:var(--surface); padding:28px; margin-top:22px; text-align:center; color:var(--ink3); font-size:14.5px; line-height:1.6;">{PLACEHOLDER_TEXT}</div>
    </div>
  </section>
</Base>
