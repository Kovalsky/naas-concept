---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { ROUTES } from '../lib/site';
import sections from '@content/data/sections.json';
import { page } from '@content/pageContent';
const docs = sections.officialDocs;
const { meta, hero } = page('/ofitsiyni-dokumenty');
---
<Base title={meta.title} description={meta.description}>
  <Hero kicker={hero!.kicker} title={hero!.title} crumbs={hero!.crumbs} lead={hero!.lead} />
  <section class="section section--white">
    <div class="wrap">
      <div class="rows">
        {docs.map((it) => (
          it.href ? (
            <a href={it.href}>
              <span style="flex:1; min-width:0;">
                <span class="row-title">{it.title}</span>
                {it.note && <span class="row-desc">{it.note}</span>}
              </span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="1.8" style="flex-shrink:0;" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
          ) : (
            <div class="row">
              <span style="flex:1; min-width:0;"><span class="row-title" style="color:var(--ink2);">{it.title}</span></span>
              <span class="mono" style="font-size:11px; color:var(--ink3); white-space:nowrap;">матеріал готується</span>
            </div>
          )
        ))}
      </div>
    </div>
  </section>
</Base>
