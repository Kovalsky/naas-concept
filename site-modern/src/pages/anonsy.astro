---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { anonsy } from '../lib/data';
import type { Anons } from '../lib/data';
import { webp } from '../lib/img';
import { parseDateUk } from '../lib/format';
import { page } from '@content/pageContent';
const { meta, hero } = page('/anonsy');

// ТЗ format "like NAN" (audit item 12): events get a date tile and a "минув"
// (past) badge, publications go to a separate strip. `kind` lives in
// content/data/anonsy.json; entries without kind count as events.
const pubs = anonsy.filter((a) => a.kind === 'publication');
const events = anonsy.filter((a) => a.kind !== 'publication');
const now = new Date();
const isPast = (a: Anons) => {
  const d = parseDateUk(a.date);
  if (!d) return false;
  d.setHours(23, 59, 59); // an event only becomes "past" the next day
  return d < now;
};
const dayOf = (s: string) => s.match(/^(\d{1,2})/)?.[1] ?? '';
const monthYearOf = (s: string) => s.replace(/^\d{1,2}\s+/, '');
---
<Base title={meta.title} description={meta.description}>
  <Hero kicker={hero!.kicker} title={hero!.title} lead={hero!.lead} />
  <section class="section section--white">
    <div class="wrap">
      <div class="kicker" style="margin-bottom:16px;">Події</div>
      <div class="ev-list">
        {events.map((a) => (
          <article class:list={['ev', isPast(a) && 'ev--past']}>
            <div class="ev-date" aria-hidden="true">
              <span class="ev-day">{dayOf(a.date)}</span>
              <span class="ev-my mono">{monthYearOf(a.date)}</span>
            </div>
            <div class="ev-body">
              <h2 class="ev-title">{a.title}{isPast(a) && <span class="ev-badge mono">минув</span>}</h2>
              <p class="ev-teaser">{a.teaser}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="kicker" style="margin:44px 0 16px;">Видання та матеріали</div>
      <div class="grid grid--auto">
        {pubs.map((a) => (
          <article style="display:flex; flex-direction:column; border:1px solid var(--line); border-radius:12px; overflow:hidden; background:var(--surface);">
            <img src={webp(a.image, 480)} alt={a.title} width="400" height="200" loading="lazy" style="width:100%; height:190px; object-fit:cover; background:var(--muted);" />
            <div style="padding:20px; display:flex; flex-direction:column; gap:9px;">
              <span class="mono" style="font-size:10.5px; letter-spacing:0.04em; color:var(--gold-ink);">{a.date}</span>
              <h2 style="font-family:var(--serif); font-size:17px; font-weight:600; color:var(--ink); line-height:1.3;">{a.title}</h2>
              <p style="font-size:13.5px; color:var(--ink2); line-height:1.55;">{a.teaser}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .ev-list { display: flex; flex-direction: column; gap: 14px; max-width: 860px; }
  .ev { display: flex; gap: 22px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); padding: 20px 22px; }
  .ev-date {
    flex-shrink: 0; width: 78px; text-align: center;
    border-right: 1px solid var(--line); padding-right: 20px;
    display: flex; flex-direction: column; justify-content: center; gap: 3px;
  }
  .ev-day { font-family: var(--serif); font-size: 34px; font-weight: 700; line-height: 1; color: var(--green); }
  .ev-my { font-size: 10.5px; letter-spacing: 0.03em; color: var(--muted-ink); }
  .ev-title { font-family: var(--serif); font-size: 17px; font-weight: 600; color: var(--ink); line-height: 1.35; }
  .ev-teaser { font-size: 13.5px; color: var(--ink2); line-height: 1.55; margin-top: 7px; }
  .ev-badge {
    display: inline-block; vertical-align: 2px; margin-left: 10px;
    font-size: 9.5px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase;
    border: 1px solid var(--line2); border-radius: 4px; padding: 2px 7px; color: var(--muted-ink);
  }
  .ev--past { opacity: 0.72; }
  .ev--past .ev-day { color: var(--muted-ink); }
  @media (max-width: 560px) {
    .ev { flex-direction: column; gap: 12px; }
    .ev-date {
      flex-direction: row; align-items: baseline; gap: 8px; width: auto;
      border-right: none; border-bottom: 1px solid var(--line); padding: 0 0 10px; text-align: left;
    }
    .ev-day { font-size: 26px; }
  }
</style>
