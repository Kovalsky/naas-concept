---
import { FOOTER } from '../lib/site';
import { BRAND } from '@content/site';
import { contacts } from '../lib/data';
import T from './T.astro';
const ext = (e?: boolean) => (e ? { target: '_blank', rel: 'noopener' } : {});
const cols: { k: string; items: readonly { label: string; href: string; external?: boolean; k: string }[] }[] = [
  { k: 'footer.sections', items: FOOTER.sections },
  { k: 'footer.documents', items: FOOTER.documents },
  { k: 'footer.resources', items: FOOTER.resources },
];
const telHref = 'tel:' + contacts.phone.replace(/[^+\d]/g, '');
---
<footer class="site-footer">
  <div class="wrap">
    <div class="f-main">
      <!-- Identity + contacts rail -->
      <div class="f-brand">
        <a href="/" class="f-id" aria-label="НААН — головна">
          <img src="/naas-emblem.png" alt="Емблема НААН" width="72" height="72" />
          <span class="f-id-text">
            <span class="f-id-name">{BRAND.nameLines[0]}<br/>{BRAND.nameLines[1]}</span>
            <span class="f-id-est"><T k="footer.est" /></span>
          </span>
        </a>

        <div class="f-contacts">
          <h2 class="f-head"><T k="footer.contacts" /></h2>
          <span class="f-tick"></span>
          <address class="f-addr">
            <span class="f-row">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>{contacts.address}</span>
            </span>
            <a class="f-row f-link" href={telHref}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
              <span class="mono">{contacts.phone}</span>
            </a>
            <a class="f-row f-link" href={`mailto:${contacts.email}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span class="mono">{contacts.email}</span>
            </a>
          </address>
        </div>
      </div>

      <!-- Link columns -->
      <div class="f-links">
        {cols.map((col) => (
          <div class="f-col">
            <h2 class="f-head"><T k={col.k} /></h2>
            <span class="f-tick"></span>
            <ul class="f-list">
              {col.items.map((it) => (
                <li>
                  <a href={it.href} class="f-link f-nav" {...ext(it.external)}>
                    <T k={it.k} />
                    {it.external && (
                      <svg class="f-ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="f-bottom">
      <div><T k="footer.copyright" /></div>
      <div class="f-bottom-meta">
        <span class="mono">ЄДРПОУ {contacts.edrpou}</span>
        <a href="/kontakty" class="f-link"><T k="footer.contacts" /></a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-deep);
    color: rgba(255, 255, 255, 0.82);
    border-top: 3px solid var(--gold);
    padding: 56px 0 26px;
  }

  /* Identity rail + link grid. The rail is fixed-ish; the links expand to
     fill the remaining width so the footer reaches the right edge. */
  .f-main {
    display: grid;
    grid-template-columns: minmax(280px, 1.15fr) minmax(0, 2.4fr);
    gap: 52px;
    padding-bottom: 40px;
  }
  .f-brand { max-width: 440px; }

  .f-id { display: flex; align-items: center; gap: 14px; margin-bottom: 26px; }
  .f-id img { flex-shrink: 0; width: 72px; height: 72px; object-fit: contain; display: block; }
  .f-id-name {
    display: block; font-family: var(--serif);
    font-size: 14px; font-weight: 600; color: #fff; line-height: 1.22;
  }
  .f-id-est {
    display: block; font-family: var(--mono);
    font-size: 10px; letter-spacing: 0.18em; color: var(--green-soft); margin-top: 6px;
  }

  /* Column / contacts label — brighter than V3 for AA contrast on navy. */
  .f-head {
    font-family: var(--mono); font-size: 10px; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.62);
  }
  .f-tick { display: block; width: 20px; height: 2px; background: var(--gold); border-radius: 1px; margin: 9px 0 16px; }

  .f-addr { font-style: normal; display: flex; flex-direction: column; gap: 12px; }
  .f-row { display: flex; align-items: flex-start; gap: 11px; font-size: 13px; line-height: 1.55; color: rgba(255, 255, 255, 0.78); }
  .f-row svg { flex-shrink: 0; width: 15px; height: 15px; margin-top: 2px; color: rgba(255, 255, 255, 0.4); transition: color 150ms ease; }
  .f-row.f-link:hover svg { color: rgba(255, 255, 255, 0.72); }

  .f-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .f-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 3px; }

  .f-link { color: rgba(255, 255, 255, 0.78); transition: color 150ms ease, transform 150ms ease; }
  .f-link:hover { color: #fff; }
  .f-nav { display: inline-flex; align-items: center; gap: 6px; padding: 6px 0; font-size: 13px; }
  .f-nav:hover { transform: translateX(3px); }
  .f-ext { width: 11px; height: 11px; opacity: 0.5; flex-shrink: 0; }

  .f-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 22px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 14px; font-size: 12px; color: rgba(255, 255, 255, 0.6);
  }
  .f-bottom-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; }

  @media (max-width: 900px) {
    .site-footer { padding: 44px 0 24px; }
    .f-main { grid-template-columns: 1fr; gap: 38px; }
    .f-nav { padding: 8px 0; min-height: 44px; }
  }
  @media (max-width: 560px) {
    .f-links { grid-template-columns: repeat(2, 1fr); gap: 26px 22px; }
  }
</style>
