---
import type { Registry } from '../lib/registries';
interface Props { registry: Registry; lead?: string }
const { registry, lead } = Astro.props;

const badgeColor: Record<string, string> = {
  PDF: '#8A6508', DOC: '#1E3A5F', DOCX: '#1E3A5F', XLS: '#1F7A4D', XLSX: '#1F7A4D',
  PNG: '#737373', JPG: '#737373', JPEG: '#737373',
};
---
<div class="kicker kicker--muted" style="margin-bottom:14px;">{registry.count} {registry.count === 1 ? 'документ' : registry.count < 5 ? 'документи' : 'документів'}</div>
{lead && <p style="font-size:15px; color:var(--ink2); line-height:1.6; margin-bottom:24px; max-width:680px;">{lead}</p>}
<div style="border:1px solid var(--line); border-radius:12px; overflow:hidden; background:var(--surface);">
  {registry.items.map((it) => (
    <a href={it.href} target="_blank" rel="noopener" style="display:flex; align-items:center; gap:18px; padding:16px 22px; border-bottom:1px solid var(--line);" class="reg-row">
      <span class="mono" style={`flex-shrink:0; width:46px; height:30px; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:600; color:#fff; border-radius:4px; background:${badgeColor[it.ext] ?? '#525252'};`}>{it.ext}</span>
      <span style="flex:1; min-width:0;">
        <span style="display:block; font-size:14.5px; line-height:1.45; color:var(--ink);">{it.title}</span>
        {it.external && <span class="mono" style="display:inline-block; margin-top:4px; font-size:10px; letter-spacing:0.04em; color:var(--ink3);">зовнішнє посилання · naas.gov.ua</span>}
      </span>
      {it.year > 0 && <span class="mono" style="flex-shrink:0; font-size:12px; color:var(--ink3);">{it.year}</span>}
      {it.external
        ? <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--ink3)" stroke-width="1.7" style="flex-shrink:0;"><path d="M7 17 17 7M7 7h10v10"/></svg>
        : <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--navy)" stroke-width="1.7" style="flex-shrink:0;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>}
    </a>
  ))}
</div>
<style>
  .reg-row:last-child { border-bottom: none; }
  .reg-row:hover { background: var(--muted2); }
</style>
