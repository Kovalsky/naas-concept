---
// Homepage "About" band — intro + mission. Text pulled verbatim from the shared
// markdown (naan-sohodni.md) so nothing is invented. Styled to match the other
// home sections (FieldRule + .kicker + .h2-serif); the mission is a light
// gold-rule callout — no heavy panel — so the band sits in the same visual family
// as «Основні розділи», «Стрічка» and the rest below it.
import { getCollection } from 'astro:content';
import { ROUTES } from '../lib/site';
import FieldRule from './FieldRule.astro';

const pages = await getCollection('pages');
const entry = pages.find((p) => p.id === 'naan-sohodni');
const body = (entry as { body?: string } | undefined)?.body ?? '';
const blocks = body.split(/\n{2,}/).map((s) => s.trim()).filter(Boolean);
const intro = blocks.find((b) => !b.startsWith('#')) ?? '';
const misIdx = blocks.findIndex((b) => /^##\s*Місія/i.test(b));
const mission = misIdx >= 0 ? (blocks[misIdx + 1] ?? '') : '';
const arrow = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M5 12h14M13 5l7 7-7 7"/></svg>`;
---
<section class="section section--white" aria-labelledby="about-h">
  <div class="wrap">
    <FieldRule />
    <div class="kicker" style="margin-bottom:8px;">Про Академію</div>
    <h2 id="about-h" class="h2-serif" style="margin-bottom:28px;">Провідний центр аграрної науки</h2>

    <div class="about-grid">
      <p class="about-intro">{intro}</p>
      <aside class="about-mission">
        <span class="kicker kicker--muted about-mission-label">Місія</span>
        <p class="about-mission-text">{mission}</p>
      </aside>
    </div>

    <a class="link-underline about-link" href={ROUTES.today}>Докладніше про НААН <Fragment set:html={arrow} /></a>
  </div>
</section>
<style>
  .about-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 48px; align-items: start; }
  .about-intro {
    font-family: var(--serif); font-weight: 400;
    font-size: clamp(18px, 1.6vw, 21px); line-height: 1.6;
    color: var(--ink2); text-wrap: pretty;
  }
  .about-mission { border-left: 2px solid var(--gold); padding-left: 22px; }
  .about-mission-label { display: block; margin-bottom: 10px; }
  .about-mission-text { font-size: 15px; line-height: 1.66; color: var(--ink2); }
  .about-link { margin-top: 32px; }
  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; gap: 26px; }
    .about-link { margin-top: 26px; }
  }
</style>
