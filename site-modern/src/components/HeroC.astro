---
// Hero C — classic, default homepage masthead. Typographic / wordmark-led (the
// header already carries the emblem). Eyebrow + H1 + gold rule + one positioning
// line + links, then the original Gravitas figures cluster (4 stats, navy serif on
// white, thin rules) — no navy band, so the hero shares the calm white/muted
// language of the sections below.
import T from './T.astro';
import { ROUTES } from '../lib/site';
import { divisionCount } from '../lib/data';
const arrow = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M5 12h14M13 5l7 7-7 7"/></svg>`;
const facts = [
  { n: '1918', k: 'home.factFounded' },
  { n: String(divisionCount), k: 'home.factDivisions' },
  { n: '84', k: 'home.factInstitutions' },
  { n: '176', k: 'home.factOrganizations' },
];
---
<section class="hc">
  <svg aria-hidden="true" class="hc-field" viewBox="0 0 1440 360" preserveAspectRatio="xMidYMax slice">
    <g fill="none" stroke="#1E3A5F" stroke-width="2">
      <path d="M0 340 Q720 280 1440 330"/><path d="M0 310 Q720 248 1440 300"/>
      <path d="M0 280 Q720 216 1440 270"/><path d="M0 250 Q720 184 1440 240"/>
      <path d="M0 220 Q720 152 1440 210"/>
    </g>
    <path d="M0 325 Q720 264 1440 315" fill="none" stroke="#B8860B" stroke-width="2"/>
  </svg>
  <div class="wrap hc-in">
    <div class="hc-kicker mono">Офіційний портал</div>
    <h1 class="hc-h1">Національна академія<br/>аграрних наук України</h1>
    <span class="hc-rule" aria-hidden="true"></span>
    <p class="hc-sub">Державна самоврядна наукова організація — науково-методичний і координаційний центр з наукових проблем розвитку АПК України.</p>
    <div class="hc-links">
      <a class="link-underline" href={ROUTES.statute}><T k="home.statuteLink" /> <Fragment set:html={arrow} /></a>
      <a class="link-underline" href={ROUTES.presidium}><T k="home.presidiumLink" /> <Fragment set:html={arrow} /></a>
      <a class="link-underline" href={ROUTES.today}><T k="btn.more" /> <Fragment set:html={arrow} /></a>
    </div>

    <div class="fact-cluster">
      {facts.map((f, i) => (
        <>
          {i > 0 && <span class="fact-div" aria-hidden="true"></span>}
          <div class="fact-col"><div class="fact-num">{f.n}</div><div class="fact-lbl mono"><T k={f.k} /></div></div>
        </>
      ))}
    </div>
  </div>
</section>
<style>
  .hc { background:var(--surface); position: relative; overflow: hidden; padding: 64px 0 60px; }
  .hc-field { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 300px; opacity: 0.06; pointer-events: none; }
  .hc-in { position: relative; max-width: 820px; margin: 0 auto; text-align: center; }
  .hc-kicker { font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--navy); margin-bottom: 18px; }
  .hc-h1 { font-family: var(--serif); font-weight: 600; font-size: clamp(30px,3.6vw,44px); line-height: 1.12; letter-spacing: -0.018em; color: var(--ink); text-wrap: balance; }
  .hc-rule { display: block; width: 54px; height: 3px; background: var(--gold); border-radius: 2px; margin: 24px auto; }
  .hc-sub { font-family: var(--serif); font-weight: 500; font-size: clamp(17px,1.9vw,21px); line-height: 1.5; color: var(--navy); max-width: 660px; margin: 0 auto; text-wrap: pretty; }
  .hc-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 28px; margin-top: 30px; }

  /* original Gravitas figures cluster: navy serif numbers on white, thin rules */
  .fact-cluster { display: flex; align-items: center; justify-content: center; margin: 46px auto 0; max-width: 840px; }
  .fact-col { flex: 1 1 0; min-width: 0; text-align: center; }
  .fact-num { font-family: var(--serif); font-size: clamp(34px,3.4vw,42px); font-weight: 600; color: var(--navy); line-height: 1; }
  .fact-lbl { font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink3); margin-top: 10px; white-space: nowrap; }
  .fact-div { flex: 0 0 1px; width: 1px; height: 42px; background: var(--line); margin: 0 18px; }
  @media (max-width: 560px) {
    .fact-cluster { flex-direction: column; gap: 22px; }
    .fact-div { display: none; }
    .fact-lbl { white-space: normal; }
  }
</style>
