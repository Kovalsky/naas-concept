{
  "name": "naas-portal-modern",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "node ../scripts/check-facts.mjs",
    "check:design": "node scripts/check-design.mjs",
    "img": "node scripts/optimize-images.mjs",
    "deploy": "npm run deploy:staging",
    "deploy:staging": "npm run build && npm run check && wrangler pages deploy dist --project-name naas-portal-modern",
    "deploy:prod": "bash ../scripts/deploy-modern-mirohost.sh"
  },
  "dependencies": {
    "astro": "^5.6.1"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "wrangler": "^3.114.1"
  }
}
